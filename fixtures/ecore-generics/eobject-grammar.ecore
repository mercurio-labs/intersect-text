<e:EPackage xmlns:e="http://www.eclipse.org/emf/2002/Ecore" xmlns:x="http://www.w3.org/2001/XMLSchema-instance" name="grammarrefs" nsURI="urn:eobject-grammar">
<eClassifiers x:type="e:EDataType" name="Text" instanceClassName="java.lang.String"/>
<eClassifiers x:type="e:EClass" name="Node"><eStructuralFeatures x:type="e:EAttribute" name="name" eType="e:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/></eClassifiers>
<eClassifiers x:type="e:EClass" name="Other"><eStructuralFeatures x:type="e:EAttribute" name="name" eType="e:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/></eClassifiers>
<eClassifiers x:type="e:EClass" name="EObject"><eStructuralFeatures x:type="e:EAttribute" name="name" eType="e:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/></eClassifiers>
<eClassifiers x:type="e:EClass" name="Box"><eTypeParameters name="T"/><eStructuralFeatures x:type="e:EAttribute" name="name" eType="e:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/></eClassifiers>
<eClassifiers x:type="e:EClass" name="Bound"><eTypeParameters name="T"><eBounds eClassifier="#//Node"/></eTypeParameters><eStructuralFeatures x:type="e:EAttribute" name="name" eType="e:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/><eStructuralFeatures x:type="e:EReference" name="target"><eGenericType eTypeParameter="#//Bound/T"/></eStructuralFeatures></eClassifiers>
<eClassifiers x:type="e:EClass" name="Root"><eStructuralFeatures x:type="e:EReference" name="nodes" eType="#//Node" upperBound="-1" containment="true"/><eStructuralFeatures x:type="e:EReference" name="others" eType="#//Other" upperBound="-1" containment="true"/><eStructuralFeatures x:type="e:EReference" name="users" eType="#//EObject" upperBound="-1" containment="true"/><eStructuralFeatures x:type="e:EReference" name="boxes" eType="#//Box" upperBound="-1" containment="true"/><eStructuralFeatures x:type="e:EReference" name="bounds" eType="#//Bound" upperBound="-1" containment="true"/><eStructuralFeatures x:type="e:EReference" name="any" eType="e:EClass http://www.eclipse.org/emf/2002/Ecore#//EObject" upperBound="-1"/><eStructuralFeatures x:type="e:EReference" name="narrow" eType="#//Node"/><eStructuralFeatures x:type="e:EReference" name="user" eType="#//EObject"/></eClassifiers>
</e:EPackage>
