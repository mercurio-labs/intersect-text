<e:EPackage xmlns:e="http://www.eclipse.org/emf/2002/Ecore" xmlns:x="http://www.w3.org/2001/XMLSchema-instance" name="lower" nsURI="urn:runtime-lower">
 <eClassifiers x:type="e:EClass" name="Base"/>
 <eClassifiers x:type="e:EClass" name="Sub" eSuperTypes="#//Base"/>
 <eClassifiers x:type="e:EClass" name="Other"/>
 <eClassifiers x:type="e:EClass" name="Pair"><eTypeParameters name="L"/><eTypeParameters name="R"/><eStructuralFeatures x:type="e:EAttribute" name="name" eType="e:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/></eClassifiers>
 <eClassifiers x:type="e:EClass" name="Owner"><eTypeParameters name="T"><eBounds eClassifier="#//Base"/></eTypeParameters><eStructuralFeatures x:type="e:EAttribute" name="name" eType="e:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/><eStructuralFeatures x:type="e:EReference" name="value"><eGenericType eClassifier="#//Pair"><eTypeArguments><eLowerBound eTypeParameter="#//Owner/T"/></eTypeArguments><eTypeArguments eTypeParameter="#//Owner/T"/></eGenericType></eStructuralFeatures></eClassifiers>
 <eClassifiers x:type="e:EClass" name="Child"><eTypeParameters name="U"><eBounds eClassifier="#//Base"/></eTypeParameters><eGenericSuperTypes eClassifier="#//Owner"><eTypeArguments eTypeParameter="#//Child/U"/></eGenericSuperTypes></eClassifiers>
 <eClassifiers x:type="e:EClass" name="Marker" interface="true"/>
 <eClassifiers x:type="e:EClass" name="Both" eSuperTypes="#//Base #//Marker"/>
 <eClassifiers x:type="e:EClass" name="Intersection"><eTypeParameters name="T"><eBounds eClassifier="#//Base"/><eBounds eClassifier="#//Marker"/></eTypeParameters><eStructuralFeatures x:type="e:EReference" name="value"><eGenericType eClassifier="#//Pair"><eTypeArguments><eLowerBound eTypeParameter="#//Intersection/T"/></eTypeArguments><eTypeArguments eTypeParameter="#//Intersection/T"/></eGenericType></eStructuralFeatures></eClassifiers>
 <eClassifiers x:type="e:EClass" name="Dependent"><eTypeParameters name="U"><eBounds eClassifier="#//Base"/></eTypeParameters><eTypeParameters name="T"><eBounds eTypeParameter="#//Dependent/U"/></eTypeParameters><eStructuralFeatures x:type="e:EReference" name="value"><eGenericType eClassifier="#//Pair"><eTypeArguments><eLowerBound eTypeParameter="#//Dependent/T"/></eTypeArguments><eTypeArguments eTypeParameter="#//Dependent/U"/></eGenericType></eStructuralFeatures></eClassifiers>
 <eClassifiers x:type="e:EClass" name="Nested"><eTypeParameters name="T"><eBounds eClassifier="#//Base"/></eTypeParameters><eStructuralFeatures x:type="e:EReference" name="value"><eGenericType eClassifier="#//Pair"><eTypeArguments><eLowerBound eClassifier="#//Pair"><eTypeArguments eTypeParameter="#//Nested/T"/><eTypeArguments eClassifier="#//Base"/></eLowerBound></eTypeArguments><eTypeArguments eTypeParameter="#//Nested/T"/></eGenericType></eStructuralFeatures></eClassifiers>
 <eClassifiers x:type="e:EClass" name="Unbounded"><eTypeParameters name="T"/><eStructuralFeatures x:type="e:EReference" name="value"><eGenericType eClassifier="#//Pair"><eTypeArguments><eLowerBound eTypeParameter="#//Unbounded/T"/></eTypeArguments><eTypeArguments eTypeParameter="#//Unbounded/T"/></eGenericType></eStructuralFeatures></eClassifiers>
 <eClassifiers x:type="e:EClass" name="BaseSub"><eGenericSuperTypes eClassifier="#//Pair"><eTypeArguments eClassifier="#//Base"/><eTypeArguments eClassifier="#//Sub"/></eGenericSuperTypes></eClassifiers>
 <eClassifiers x:type="e:EClass" name="SubSub"><eGenericSuperTypes eClassifier="#//Pair"><eTypeArguments eClassifier="#//Sub"/><eTypeArguments eClassifier="#//Sub"/></eGenericSuperTypes></eClassifiers>
 <eClassifiers x:type="e:EClass" name="BaseOther"><eGenericSuperTypes eClassifier="#//Pair"><eTypeArguments eClassifier="#//Base"/><eTypeArguments eClassifier="#//Other"/></eGenericSuperTypes></eClassifiers>
 <eClassifiers x:type="e:EClass" name="Root"><eStructuralFeatures x:type="e:EReference" name="items" upperBound="-1" containment="true" eType="#//Pair"/><eStructuralFeatures x:type="e:EReference" name="owners" upperBound="-1" containment="true" eType="#//Owner"/></eClassifiers>
 <eClassifiers x:type="e:EClass" name="ClosedOwner"><eGenericSuperTypes eClassifier="#//Owner"><eTypeArguments eClassifier="#//Sub"/></eGenericSuperTypes></eClassifiers>
</e:EPackage>
