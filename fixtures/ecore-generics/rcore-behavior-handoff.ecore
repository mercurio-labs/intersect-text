<e:EPackage xmlns:e="http://www.eclipse.org/emf/2002/Ecore" xmlns:x="http://www.w3.org/2001/XMLSchema-instance" name="handoff" nsURI="urn:rcore-behavior-handoff">
  <eClassifiers x:type="e:EClass" name="Base">
    <eStructuralFeatures x:type="e:EAttribute" name="name" lowerBound="1" eType="e:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers x:type="e:EClass" name="Leaf" eSuperTypes="#//Base"/>
  <eClassifiers x:type="e:EClass" name="Other"/>
  <eClassifiers x:type="e:EClass" name="Box" eSuperTypes="#//Base">
    <eTypeParameters name="T"><eBounds eClassifier="#//Base"/></eTypeParameters>
    <eStructuralFeatures x:type="e:EReference" name="value" lowerBound="1"><eGenericType eTypeParameter="#//Box/T"/></eStructuralFeatures>
    <eStructuralFeatures x:type="e:EReference" name="optional"><eGenericType eTypeParameter="#//Box/T"/></eStructuralFeatures>
    <eStructuralFeatures x:type="e:EReference" name="items" upperBound="-1" ordered="false" unique="false"><eGenericType eTypeParameter="#//Box/T"/></eStructuralFeatures>
  </eClassifiers>
  <eClassifiers x:type="e:EClass" name="Left"><eGenericSuperTypes eClassifier="#//Box"><eTypeArguments eClassifier="#//Leaf"/></eGenericSuperTypes></eClassifiers>
  <eClassifiers x:type="e:EClass" name="Right"><eGenericSuperTypes eClassifier="#//Box"><eTypeArguments eClassifier="#//Leaf"/></eGenericSuperTypes></eClassifiers>
  <eClassifiers x:type="e:EClass" name="Diamond" eSuperTypes="#//Left #//Right"/>
  <eClassifiers x:type="e:EClass" name="Open">
    <eTypeParameters name="T"/>
    <eStructuralFeatures x:type="e:EReference" name="value" lowerBound="1"><eGenericType eTypeParameter="#//Open/T"/></eStructuralFeatures>
  </eClassifiers>
</e:EPackage>
