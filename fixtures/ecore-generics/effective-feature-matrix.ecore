<e:EPackage xmlns:e="http://www.eclipse.org/emf/2002/Ecore" xmlns:x="http://www.w3.org/2001/XMLSchema-instance" name="features" nsURI="urn:generic-features">
  <eClassifiers x:type="e:EEnum" name="Color">
    <eLiterals name="Primary" value="7" literal="primary"/>
    <eLiterals name="Alias" value="7" literal="alias"/>
  </eClassifiers>
  <eClassifiers x:type="e:EEnum" name="OtherColor">
    <eLiterals name="Primary" value="7" literal="primary"/>
    <eLiterals name="Alias" value="7" literal="alias"/>
  </eClassifiers>
  <eClassifiers x:type="e:EClass" name="Record">
    <eTypeParameters name="T"/>
    <eStructuralFeatures x:type="e:EAttribute" name="name" eType="e:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures x:type="e:EAttribute" name="selected" defaultValueLiteral="alias"><eGenericType eTypeParameter="#//Record/T"/></eStructuralFeatures>
    <eStructuralFeatures x:type="e:EAttribute" name="first" lowerBound="1"><eGenericType eTypeParameter="#//Record/T"/></eStructuralFeatures>
    <eStructuralFeatures x:type="e:EAttribute" name="choices" upperBound="2" ordered="false" unique="true"><eGenericType eTypeParameter="#//Record/T"/></eStructuralFeatures>
    <eStructuralFeatures x:type="e:EAttribute" name="history" upperBound="-1" ordered="true" unique="false"><eGenericType eTypeParameter="#//Record/T"/></eStructuralFeatures>
  </eClassifiers>
  <eClassifiers x:type="e:EClass" name="Left"><eGenericSuperTypes eClassifier="#//Record"><eTypeArguments eClassifier="#//Color"/></eGenericSuperTypes></eClassifiers>
  <eClassifiers x:type="e:EClass" name="Right"><eGenericSuperTypes eClassifier="#//Record"><eTypeArguments eClassifier="#//Color"/></eGenericSuperTypes></eClassifiers>
  <eClassifiers x:type="e:EClass" name="Diamond" eSuperTypes="#//Left #//Right"/>
  <eClassifiers x:type="e:EClass" name="OtherRecord"><eGenericSuperTypes eClassifier="#//Record"><eTypeArguments eClassifier="#//OtherColor"/></eGenericSuperTypes></eClassifiers>
</e:EPackage>
