<e:EPackage xmlns:e="http://www.eclipse.org/emf/2002/Ecore" xmlns:x="http://www.w3.org/2001/XMLSchema-instance" name="handoff" nsURI="urn:rcore-behavior-provider-handoff">
  <eClassifiers x:type="e:EDataType" name="RGB" instanceClassName="example.RGB"/>
