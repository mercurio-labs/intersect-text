<e:EPackage xmlns:e="http://www.eclipse.org/emf/2002/Ecore" xmlns:x="http://www.w3.org/2001/XMLSchema-instance" name="deletion" nsURI="urn:deletion">
<eClassifiers x:type="e:EClass" name="Node">
<eStructuralFeatures x:type="e:EReference" name="children" upperBound="-1" containment="true" unsettable="true" eType="#//Node" eOpposite="#//Node/parent"/>
<eStructuralFeatures x:type="e:EReference" name="parent" unsettable="true" eType="#//Node" eOpposite="#//Node/children"/>
<eStructuralFeatures x:type="e:EReference" name="link" unsettable="true" eType="#//Node"/>
</eClassifiers>
</e:EPackage>
