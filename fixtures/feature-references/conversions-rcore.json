                },
                {
                  "id": {
                    "uri": "memory:rcore_behavior",
                    "sha256": "a86f5e1f4a2800151976c6d9c522ce2cd091c4bb8f58f0b7c7f1a3750cc6fea3"
                  },
                  "kind": "rcore_behavior",
                  "text": "rcore 1;\npackage fixtureProviders version \"1\";\nimport model \"urn:intersect:example:library:1\" as m;\nderive m.`Library`.`copyCount` using count(`copies`);\nderive m.`BookCopy`.`available` using noIncoming(m.`Loan`.`copy`);\nvalidate m.`Loan`.rule0(self) {\n  require size(incoming::<m.`Loan`>(self.`copy`, \"copy\")) <= 1\n    code \"rule0\" message \"A book copy cannot have more than one active loan.\";\n}\n",
                  "dependencies": [
