                  "kind": "rcore",
                  "text": "rcore 1;\npackage `library` version \"1\";\nmetamodel \"urn:intersect:example:library:1\" prefix `lib` {\n  abstract class `Named` {\n    attr `name`: EString [1,1];\n  }\n  class `Library` extends external \"#//@eClassifiers.0\" {\n    ref `copies`: external \"#//@eClassifiers.2\" [0,*] containment opposite external \"#//@eClassifiers.2/@eStructuralFeatures.4\";\n    ref `members`: external \"#//@eClassifiers.3\" [0,*] containment;\n    ref `loans`: external \"#//@eClassifiers.4\" [0,*] containment;\n    attr `copyCount`: EInt [0,1] derived;\n  }\n  class `BookCopy` extends external \"#//@eClassifiers.0\" {\n    attr `entry`: external \"http://www.eclipse.org/emf/2002/Ecore#//EFeatureMapEntry\" [0,1];\n    attr `featureMap`: external \"http://www.eclipse.org/emf/2002/Ecore#//EFeatureMap\" [0,1];\n    attr `title`: EString [0,1];\n    attr `edition`: EInt [0,1] default \"1\";\n    ref `library`: external \"#//@eClassifiers.1\" [0,1] opposite external \"#//@eClassifiers.1/@eStructuralFeatures.0\";\n    attr `available`: EBoolean [0,1] derived;\n  }\n  class `Member` extends external \"#//@eClassifiers.0\" {\n  }\n  class `Loan` extends external \"#//@eClassifiers.0\" {\n    ref `copy`: external \"#//@eClassifiers.2\" [1,1];\n    ref `member`: external \"#//@eClassifiers.3\" [1,1];\n  }\n  class `SpecialCopy` extends external \"#//@eClassifiers.2\" {\n  }\n}\n"
                },
                {
                  "id": {
                    "uri": "memory:xtext",
                    "sha256": "ae3bcebc48bb3c7c1df558929cb8487fdf68bea87ae494b0c72a4168a91d6ba7"
                  },
                  "kind": "xtext",
                  "text": "grammar example.Library with org.eclipse.xtext.common.Terminals\nimport \"urn:intersect:example:library:1\" as lib\n\nLibrary returns lib::Library:\n  'library' name=ID '{'\n    (copies+=BookCopy | members+=Member | loans+=Loan)*\n  '}';\n\nBookCopy returns lib::BookCopy:\n  'copy' name=ID title=STRING ('edition' edition=INT)? ';';\n\nMember returns lib::Member:\n  'member' name=ID ';';\n\nLoan returns lib::Loan:\n  'loan' name=ID 'copy' copy=[lib::BookCopy|ID]\n  'to' member=[lib::Member|ID] ';';\n",
                  "dependencies": [
                    {
                      "sha256": "feed732a6d9a79cbeefa2101d00dc9773b1af357e85f9a67cfaf782bdd71b183",
                      "uri": "memory:model.rcore"
                    }
