<ecore:EPackage xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="diagnostics" nsURI="urn:intersect:diagnostics" nsPrefix="diagnostics">
  <eClassifiers xsi:type="ecore:EDataType" name="Chain" instanceClassName="org.eclipse.emf.common.util.DiagnosticChain" serializable="false"/>
  <eClassifiers xsi:type="ecore:EClass" name="Report">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="diagnostics" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDiagnosticChain"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="history" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDiagnosticChain"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="localDiagnostics" eType="#//Chain"/>
    <eOperations name="identity" eType="http://www.eclipse.org/emf/2002/Ecore#//EDiagnosticChain">
      <eParameters name="diagnostics" eType="http://www.eclipse.org/emf/2002/Ecore#//EDiagnosticChain"/>
    </eOperations>
  </eClassifiers>
</ecore:EPackage>
