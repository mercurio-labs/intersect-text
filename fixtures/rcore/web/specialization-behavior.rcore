rcore 1;
package demo.specialization version "1";
import model "urn:intersect:rcore:web-specialization" as m;
fn main(node:m.Type)->OrderedSet<m.Type> {
  closure([node], |t| directGenerals(t))
}
fn directGenerals(t:m.Type)->Sequence<m.Type> {
  Sequence(map(incoming::<m.Specialization>(t, "specific"), |s| s.general))
}
