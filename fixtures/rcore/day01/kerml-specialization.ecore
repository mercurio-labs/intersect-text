<ecore:EPackage xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="kermlSpecializationDemo" nsURI="urn:intersect:rcore:kerml-specialization-demo" nsPrefix="demo">
  <eClassifiers xsi:type="ecore:EClass" name="Type"/>
  <eClassifiers xsi:type="ecore:EClass" name="Specialization">
    <eStructuralFeatures xsi:type="ecore:EReference" name="general" ordered="false" lowerBound="1" eType="#//Type"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="specific" ordered="false" lowerBound="1" eType="#//Type"/>
  </eClassifiers>
</ecore:EPackage>
