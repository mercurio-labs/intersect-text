rcore 1;
package demo.kerml_specialization version "1";
import model "urn:intersect:rcore:kerml-specialization-demo" as m;

fn main(xs:Sequence<m.Type>)->OrderedSet<m.Type> {
  closure(xs, |t| directGenerals(t))
}

fn directGenerals(t:m.Type)->Sequence<m.Type> {
  Sequence(map(incoming::<m.Specialization>(t, "specific"), |s| s.general))
}
