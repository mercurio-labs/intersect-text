grammar forwardedFragments hidden(WS)
import "urn:intersect:xtext:current-actions:1" as k
import "http://www.eclipse.org/emf/2002/Ecore" as ecore
Model returns k::Model: name=ID '=' value=Forward ';';
Forward returns k::Expression: (Plus | All) Suffix;
Plus returns k::OperatorExpression: 'plus' operator='+';
All returns k::OperatorExpression: 'all' operator='all';
fragment Suffix returns k::OperatorExpression: '(' operand+=Literal (',' operand+=Literal)* ')';
Literal returns k::Literal: value=INT;
terminal ID: ('a'..'z'|'A'..'Z')+;
terminal INT returns ecore::EInt: ('0'..'9')+;
terminal WS: ' '+;
