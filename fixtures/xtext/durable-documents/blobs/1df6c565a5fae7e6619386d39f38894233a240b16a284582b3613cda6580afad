fn serialize_origins<S:serde::Serializer>(origins:&Arc<Origins>,s:S)->Result<S::Ok,S::Error>{origins.entries.serialize(s)}
impl DocumentSnapshot {
 pub fn origins(&self)->&[GrammarOrigin]{&self.origins.entries}
 pub fn semantic_object(&self,node:NodeId)->Result<Option<usize>,String>{
  let mut next=Some(node);let mut remaining=self.document.nodes().len();
  while let Some(id)=next{if remaining==0{return Err("Cyclic document parent links".into())}remaining-=1;let n=self.document.nodes().get(id.0).ok_or("Unknown document node")?;if n.data.semantic_object.is_some(){return Ok(n.data.semantic_object)}next=n.parent;}Ok(None)
 }
}
impl Capture {
 fn new(source:&Source,revision:u64,origins:Arc<Origins>,limits:AnalysisLimits)->Result<Self,String>{
  // Source admission precedes its only owned copy and the builder's digest.
  if source.text.len()>limits.tree.source_bytes{return Err("Document source byte budget exceeded".into())}
  let builder=DocumentBuilder::from_source(&source.uri,&source.text,revision,limits.tree)?;
  Ok(Self{builder,origins,frames:Vec::new(),frame_undo:Vec::new(),emitted:0,issues:Vec::new(),features:Vec::new(),calls:Vec::new(),lexical_issues:Vec::new(),pending_error:None,recovering:false,recovered_match:false,last_error_index:None,limits,usage:AssociationUsage::default()})
 }
 pub(crate) fn mark(&mut self)->Result<Mark,String>{Ok(Mark{tree:self.builder.mark()?,emitted:self.emitted,issues:self.issues.len(),features:self.features.len(),frames:self.frames.len(),frame_undo:self.frame_undo.len(),pending_error:self.pending_error,recovering:self.recovering,recovered_match:self.recovered_match,last_error_index:self.last_error_index})}
 pub(crate) fn check_mark(&self,mark:&Mark)->Result<(),String>{self.builder.check_mark(&mark.tree)}
 pub(crate) fn commit(&mut self,mark:Mark)->Result<(),String>{self.builder.commit(mark.tree)}
 pub(crate) fn rollback(&mut self,mark:Mark)->Result<(),String>{self.builder.rollback(mark.tree)?;self.emitted=mark.emitted;self.issues.truncate(mark.issues);self.features.truncate(mark.features);while self.frame_undo.len()>mark.frame_undo{let(index,frame)=self.frame_undo.pop().ok_or("Missing document frame undo")?;if index<mark.frames{*self.frames.get_mut(index).ok_or("Missing original document frame")?=frame;}}self.frames.truncate(mark.frames);self.pending_error=mark.pending_error;self.recovering=mark.recovering;self.recovered_match=mark.recovered_match;self.last_error_index=mark.last_error_index;Ok(())}
 pub(crate) fn begin(&mut self,key:&str,at:usize)->Result<NodeId,String>{
  self.usage.admit(self.limits,std::mem::size_of::<Frame>(),1)?;
  let node=self.builder.begin(at,NodeData{origin:Some(self.origins.get(key)?),..NodeData::default()})?;
  self.frames.push(Frame{node,anchor:node,fallback:at});Ok(node)
 }
 pub(crate) fn close(&mut self,node:NodeId)->Result<(),String>{
  let frame=self.frames.last().ok_or("Missing document frame")?;if frame.anchor!=node{return Err("Document parser frame mismatch".into())}
  self.builder.close_from_children(frame.node,frame.fallback)?;self.frames.pop();Ok(())
 }
 pub(crate) fn action(&mut self,key:&str)->Result<(),String>{
  let index=self.frames.len().checked_sub(1).ok_or("Missing action document frame")?;let before=self.frames[index];
  self.usage.admit(self.limits,std::mem::size_of::<(usize,Frame)>(),1)?;
  let node=self.builder.wrap_open(before.node,NodeData{origin:Some(self.origins.get(key)?),..NodeData::default()})?;
  self.frame_undo.push((index,before));self.frames[index].node=node;Ok(())
 }
 pub(crate) fn push_call(&mut self,path:&str)->Result<(),String>{
  if self.calls.len()>=128{return Err("Document recovery call depth exceeded".into())}
  self.usage.admit(self.limits,std::mem::size_of::<String>()+path.len(),1)?;self.calls.push(path.to_owned());Ok(())
 }
 pub(crate) fn associate(&mut self,object:usize)->Result<(),String>{
  let frame=self.frames.last().ok_or("Missing semantic document frame")?;let mut data=self.builder.node_data(frame.node)?;data.semantic_object=Some(object);data.direct_semantic_association=true;self.builder.set_data(frame.node,data)
 }
 pub(crate) fn feature(&mut self,owner:&str,feature:&str,node:NodeId)->Result<(),String>{
  self.usage.admit(self.limits,std::mem::size_of::<FeatureNode>()+owner.len()+feature.len(),1)?;self.features.push(CapturedFeature{owner:owner.into(),feature:feature.into(),node});Ok(())
 }
 pub(crate) fn lexical_issues(&mut self,issues:Vec<grammar::LexicalIssue>)->Result<(),String>{
  self.usage.admit(self.limits,issues.len().checked_mul(std::mem::size_of::<grammar::LexicalIssue>()).ok_or("Document lexical size overflow")?,issues.len())?;self.lexical_issues=issues;Ok(())
 }
 pub(crate) fn lexical_leaf(&mut self,index:usize,range:TextRange)->Result<Option<NodeId>,String>{
  let Some(issue)=self.lexical_issues.iter().find(|e|e.token==index)else{return Ok(None)};
  let display=issue.unit.and_then(|u|char::from_u32(u.into())).map_or_else(||"<EOF>".into(),|c|c.to_string().replace('\n',"\\n").replace('\r',"\\r").replace('\t',"\\t"));
  let message=if let Some(expected)=issue.expected{let expected=char::from_u32(expected.into()).ok_or("Unrepresentable expected lexer unit")?.to_string().replace('\n',"\\n").replace('\r',"\\r").replace('\t',"\\t");format!("mismatched character '{display}' expecting '{expected}'")}else{format!("no viable alternative at character '{display}'")};
  self.usage.admit(self.limits,std::mem::size_of::<SyntaxIssue>()+message.len(),1)?;let error=self.issues.len();self.issues.push(SyntaxIssue{message,range,expected:None,recovery:Recovery::Lexical});
  Ok(Some(self.builder.leaf(range,NodeData{origin:None,hidden:true,syntax_error:Some(error),..NodeData::default()})?))
 }
 pub(crate) fn matched(&mut self){if self.recovered_match{self.recovered_match=false}else{self.recovering=false;}}
 pub(crate) fn report(&mut self,message:String,range:TextRange,expected:Option<String>,recovery:Recovery,force:bool)->Result<(),String>{
  if self.pending_error.is_some()||(self.recovering&&!force){return Ok(())}
  let was_recovering=self.recovering;
  self.issue(message,range,expected,recovery)?;
  // Generated rule catches invoke recover directly, not reportError. The
  // pinned recover helper attaches currentError without entering report suppression.
  self.recovering=if force{was_recovering}else{true};Ok(())
 }
 pub(crate) fn issue(&mut self,message:String,range:TextRange,expected:Option<String>,recovery:Recovery)->Result<usize,String>{
  self.usage.admit(self.limits,std::mem::size_of::<SyntaxIssue>()+message.len()+expected.as_ref().map_or(0,String::len),1)?;let id=self.issues.len();self.issues.push(SyntaxIssue{message,range,expected,recovery});self.pending_error=Some(id);Ok(id)
 }
 pub(crate) fn leaf(&mut self,key:Option<&str>,range:TextRange,hidden:bool)->Result<NodeId,String>{
  let error=if hidden{None}else{self.pending_error.take()};self.builder.leaf(range,NodeData{origin:key.map(|key|self.origins.get(key)).transpose()?,hidden,syntax_error:error,..NodeData::default()})
 }
 pub(crate) fn finish(mut self)->Result<DocumentSnapshot,String>{
  if !self.frames.is_empty(){return Err("Unclosed parser document frame".into())}
  if let Some(error)=self.pending_error.take(){self.builder.attach_final_error(error)?;}
  let (document,tree_usage,remapping)=self.builder.finish_with_remapping()?;
  if let Some(remapping)=remapping{for feature in &mut self.features{feature.node=remapping.node(feature.node)?;}}
  Ok(DocumentSnapshot{document,origins:self.origins,syntax_issues:self.issues,lexical_issues:self.lexical_issues,feature_nodes:Vec::new(),semantic_objects:Vec::new(),schema_revision:String::new(),parse_stage:ParseStage::default(),captured_features:self.features,tree_usage,association_usage:self.usage})
 }
}
/// Actual owned parser-stage observations, captured before reference linking,
/// model validation and semantic execution. No Deserialize/ModelStore facade.
#[derive(Debug,Serialize,Default)]
pub struct ParseStage {pub objects:Vec<ParsedObject>,pub references:Vec<ParsedReference>,pub returned:Option<entry::EntryValue>}
#[derive(Debug,Serialize)]
pub struct ParsedObject {pub id:String,pub class:String,pub type_identity:String,pub resource:String,pub start:usize,pub end:usize,pub values:BTreeMap<String,Value>}
#[derive(Debug,Serialize)]
pub struct ParsedReference {pub owner:String,pub field:String,pub spelling:String,pub target:String,pub source:SourceId,pub start:usize,pub end:usize,pub index:Option<usize>,pub active:bool}
impl DocumentSnapshot {
 pub(crate) fn capture_parse_stage<S:ModelRead>(&mut self,store:&S,uri:&str,count:usize,pending:&[Pending],returned:Option<entry::EntryValue>,limits:AnalysisLimits)->Result<(),String>{
  for index in 0..count{
   self.association_usage.admit(limits,uri.len().checked_add(32).ok_or("Parse-stage identity storage overflow")?,0)?;let id=format!("{uri}#{index}");
   let found=store.inspect(&id,&mut |view|{
    let header=[view.id().len(),view.class().len(),view.type_identity().len(),view.resource().len(),std::mem::size_of::<ParsedObject>()].into_iter().try_fold(0usize,|n,v|n.checked_add(v).ok_or("Parse-stage object storage overflow"))?;
    self.association_usage.admit(limits,header,1)?;let mut values=BTreeMap::new();
    for(name,value)in view.fields(){
     let mut budget=intersect_model::definitions::metadata_limits::TraversalBudget::new(limits.association_operations.saturating_sub(self.association_usage.operations),64,limits.association_bytes.saturating_sub(self.association_usage.bytes));
     let payload=budget.inspect(&value)?;let visits=budget.visited_nodes();
     let bytes=visits.checked_mul(intersect_model::definitions::retained_storage::RETAINED_NODE_BYTES).and_then(|v|v.checked_add(payload)).and_then(|v|v.checked_add(name.len())).ok_or("Parse-stage value storage overflow")?;
     for _ in 0..visits{self.association_usage.admit(limits,0,0)?;}
     self.association_usage.admit(limits,bytes,visits)?;values.insert(name.to_owned(),value.to_json());
    }
    self.parse_stage.objects.push(ParsedObject{id:view.id().into(),class:view.class().into(),type_identity:view.type_identity().into(),resource:view.resource().into(),start:view.start(),end:view.end(),values});Ok(())
   })?;if !found{return Err("Parse-stage object disappeared before linking".into())}
  }
  for reference in pending{
   if reference.uri!=self.document.source().uri||reference.start>reference.end||self.document.text().get(reference.start..reference.end).is_none(){return Err("Parse-stage reference is outside exact source".into())}
   let bytes=[reference.owner.len(),reference.field.len(),reference.spelling.len(),reference.target.len(),self.document.source().uri.len(),self.document.source().sha256.len(),std::mem::size_of::<ParsedReference>()].into_iter().try_fold(0usize,|n,v|n.checked_add(v).ok_or("Parse-stage reference storage overflow"))?;
   self.association_usage.admit(limits,bytes,1)?;self.parse_stage.references.push(ParsedReference{owner:reference.owner.clone(),field:reference.field.clone(),spelling:reference.spelling.clone(),target:reference.target.clone(),source:self.document.source().clone(),start:reference.start,end:reference.end,index:reference.index,active:reference.active});
  }
  if let Some(value)=&returned{let payload=match value{entry::EntryValue::Object(s)|entry::EntryValue::Datatype(s)=>s.len(),entry::EntryValue::Empty=>0};self.association_usage.admit(limits,payload+std::mem::size_of::<entry::EntryValue>(),1)?;}
  self.parse_stage.returned=returned;Ok(())
 }
}
fn declaration_payload(source:&SourceId,path:&[usize])->Result<usize,String>{source.uri.len().checked_add(source.sha256.len()).and_then(|v|v.checked_add(path.len().checked_mul(std::mem::size_of::<usize>())?)).ok_or_else(||"Document declaration storage overflow".into())}
fn member_payload(member:&intersect_model::definitions::schema::MemberIdentity)->Result<usize,String>{
 use intersect_model::definitions::schema::MemberIdentity;
 match member {MemberIdentity::Source{declaration}=>declaration_payload(&declaration.source,&declaration.path),MemberIdentity::Programmatic{revision,namespace,owner,name}=>[revision.len(),namespace.len(),owner.len(),name.len()].into_iter().try_fold(0usize,|n,v|n.checked_add(v).ok_or_else(||"Document member storage overflow".into()))}
}
impl DocumentSnapshot {
 fn bind_model(&mut self,model:&Model,schema:&intersect_model::definitions::schema::Schema,limits:AnalysisLimits)->Result<(),String>{
  self.association_usage.admit(limits,schema.revision.len(),0)?;self.schema_revision=schema.revision.clone();
  for element in &model.elements{
   let classifier=schema.declarations.get(&element.class).ok_or("Document model class lacks a source declaration")?;
   let payload=declaration_payload(&classifier.source,&classifier.path)?.checked_add(classifier.namespace.len()).and_then(|v|v.checked_add(classifier.name.len())).and_then(|v|v.checked_add(element.id.len())).and_then(|v|v.checked_add(element.class.len())).and_then(|v|v.checked_add(std::mem::size_of::<SemanticObjectIdentity>())).ok_or("Document object association storage overflow")?;
   self.association_usage.admit(limits,payload,1)?;
   self.semantic_objects.push(SemanticObjectIdentity{id:element.id.clone(),class:element.class.clone(),classifier:classifier.clone(),runtime_type:schema.instantiations.get(&element.class).cloned()});
  }
  for node in self.document.nodes(){if let Some(object)=node.data.semantic_object{if object>=self.semantic_objects.len(){return Err("Document semantic locator escapes actual analyzed objects".into())}}}
  for feature in std::mem::take(&mut self.captured_features){
   let mut selected=None;
   for(index,element)in model.elements.iter().enumerate(){self.association_usage.admit(limits,0,0)?;if element.id==feature.owner{if selected.is_some(){return Err("Ambiguous document feature owner".into())}selected=Some((index,element));}}
   let(owner_object,element)=selected.ok_or("Document feature owner is not in analyzed model")?;
   let member=schema.effective_feature(&element.class,&feature.feature)?;
   self.association_usage.admit(limits,std::mem::size_of::<FeatureNode>().checked_add(member_payload(&member.identity)?).ok_or("Document feature identity storage overflow")?,1)?;
   self.feature_nodes.push(FeatureNode{owner:feature.owner,owner_object,feature:feature.feature,node:feature.node,identity:member.identity});
  }
  Ok(())
 }
}
