pub(crate) struct Request<'a>{origins:Arc<Origins>,limits:AnalysisLimits,output:&'a mut Vec<DocumentSnapshot>}
impl Request<'_>{
 pub(crate) fn capture(&self,source:&Source)->Result<Capture,String>{Capture::new(source,0,Arc::clone(&self.origins),self.limits)}
 pub(crate) fn push(&mut self,snapshot:DocumentSnapshot){self.output.push(snapshot)}
}
impl DocumentLanguage {
 pub fn analyze(&self,source:&Source,selected_entry:Option<&str>,limits:EvaluationLimits)->Result<DocumentAnalysis,String>{
  if let Some(entry)=selected_entry {if !self.entry.entries().contains_key(entry){return Err(format!("No emitted no-argument parser entry for {entry}"))}}
  let package=self.package();let mut store=storage::MemoryStore::with_index_policy(evaluation_index_policy(package));let mut documents=Vec::new();
  let result=storage::atomic(&mut store,|store|evaluate_staged(package,std::slice::from_ref(source),Invocation{limits,entry:selected_entry,values:None,documents:Some(Request{origins:Arc::clone(&self.origins),limits:self.limits,output:&mut documents})},store,None,None,&query::PackageDerived(package)))?;
  let model=store.into_model()?;if documents.len()!=1{return Err("Document analysis did not produce exactly one source snapshot".into())}
  let mut snapshot=documents.pop().ok_or("Missing document snapshot")?;
  let resource=model.resources.get(&source.uri).ok_or("Missing analyzed resource record")?;
  snapshot.document=snapshot.document.bind_resource(resource)?;
  snapshot.bind_model(&model,&package.schema,self.limits)?;
  let diagnostics=result.diagnostics;
  if diagnostics.is_empty()&&snapshot.syntax_issues.is_empty(){
   Ok(DocumentAnalysis{snapshot,diagnostics:Vec::new(),valid_model:Some(Evaluation{model,diagnostics,references:result.references,derived:result.derived}),recovered:None})
  }else{
   let recovered=RecoveredGraph{schema_revision:model.schema_revision,objects:model.elements.into_iter().map(|element|RecoveredObject{element}).collect(),resources:model.resources};
   Ok(DocumentAnalysis{snapshot,diagnostics,valid_model:None,recovered:Some(recovered)})
  }
 }
}
