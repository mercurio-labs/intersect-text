fn lex_syntax(source: &str) -> Result<SyntaxTokens, (usize, String)> {
    scan(
        source,
        Some(50_000),
        LexicalPolicy {
            keywords: None,
            terminals: None,
            hidden: None,
            prediction: None,
            syntax: true,
        },
        &mut None,
    )
    .map(|scanned| SyntaxTokens {
