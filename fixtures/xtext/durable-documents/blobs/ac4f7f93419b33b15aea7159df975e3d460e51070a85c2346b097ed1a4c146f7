                entry = rule.clone();
            }
            if terminals.contains_key(&rule) {
                return Err(format!("Duplicate rule {rule}"));
            }
            if rules.len() + terminals.len() >= declaration_limit {
                return Err("Grammar rule budget exceeded".into());
            }
            if rules
                .insert(
                    rule.clone(),
                    Rule {
                        hidden,
                        enum_literals: BTreeMap::new(),
                        inferred_return,
                        override_declared,
                        datatype,
                        fragment,
                        wildcard,
                        class,
                        body,
                    },
                )
                .is_some()
            {
                return Err(format!("Duplicate rule {rule}"));
            }
        }
        if entry.is_empty()
            && (!composition
                || !matches!(
                    profile,
                    Profile::NativeV51
                        | Profile::NativeV52
                        | Profile::NativeV53
                        | Profile::NativeV54
                        | Profile::NativeV55
                        | Profile::NativeV56
                        | Profile::NativeV57
                        | Profile::NativeV58
                        | Profile::NativeV59
                        | Profile::NativeV60
                        | Profile::NativeV61
                        | Profile::NativeV62
                        | Profile::NativeV63
                        | Profile::NativeV64 | Profile::NativeV65
                )
                || (rules.is_empty() && terminals.is_empty()))
            && !(composition
                && matches!(
                    profile,
                    Profile::NativeV50
                        | Profile::NativeV51
                        | Profile::NativeV52
                        | Profile::NativeV53
                        | Profile::NativeV54
                        | Profile::NativeV55
                        | Profile::NativeV56
                        | Profile::NativeV57
                        | Profile::NativeV58
                        | Profile::NativeV59
                        | Profile::NativeV60
                        | Profile::NativeV61
                        | Profile::NativeV62
                        | Profile::NativeV63
                        | Profile::NativeV64 | Profile::NativeV65
                )
                && rules.is_empty()
                && !terminals.is_empty())
            && !(composition
                && parent.is_some()
                && matches!(
                    profile,
                    Profile::NativeV43
                        | Profile::NativeV44
                        | Profile::NativeV45
                        | Profile::NativeV46
                        | Profile::NativeV47
                        | Profile::NativeV48
                        | Profile::NativeV49
                        | Profile::NativeV50
                        | Profile::NativeV51
                        | Profile::NativeV52
                        | Profile::NativeV53
                        | Profile::NativeV54
                        | Profile::NativeV55
                        | Profile::NativeV56
                        | Profile::NativeV57
                        | Profile::NativeV58
                        | Profile::NativeV59
                        | Profile::NativeV60
                        | Profile::NativeV61
                        | Profile::NativeV62
                        | Profile::NativeV63
                        | Profile::NativeV64 | Profile::NativeV65
                ))
