/// Analyze one exact Xtext source with explicit computed-setting requirements.
/// This admits grammar structure only; a language host must install matching
/// providers and preserve these requirements during source/archive replay.
#[cfg(feature = "text-compiler")]
pub fn compile_with_settings(
    source: &crate::definitions::bundle::DefinitionSource,
    schema: &Schema,
    profile: Profile,
    bundle: &crate::definitions::bundle::DefinitionBundle,
    contracts: &[crate::definitions::setting::ComputedSettingContract],
) -> Result<Grammar, Diagnostic> {
    if profile.has_terminal_cardinality_decisions() {
        return Err(Diagnostic::at_source(
            &source.id,
            0,
            1,
            "NativeV63 requires language-owned authored-source validation",
        ));
    }
    validate_setting_contracts(source, schema, profile, bundle, contracts)?;
    let mut grammar = compile_with_setting_declarations(
        &source.text,
        schema,
        profile,
        128,
        contracts.to_vec(),
        Default::default(),
    )
    .map_err(|mut diagnostic| {
        diagnostic.source = source.id.uri.clone();
        if profile.has_contextual_first_rule() {
            diagnostic.with_source(&source.id)
        } else {
            diagnostic
        }
    })?;
    for span in grammar.declaration_sources.values_mut() {
        span.source = source.id.clone();
    }
    Ok(grammar)
}
#[cfg(feature = "text-compiler")]
pub(crate) fn validate_setting_contracts(
    source: &crate::definitions::bundle::DefinitionSource,
    schema: &Schema,
    profile: Profile,
    bundle: &crate::definitions::bundle::DefinitionBundle,
    contracts: &[crate::definitions::setting::ComputedSettingContract],
) -> Result<(), Diagnostic> {
    let error =
        |message: String| Diagnostic::new(&source.id.uri, 0, 1, message).with_context(&source.id);
    if !profile.has_computed_settings() {
        return Err(error(
            "Computed setting admission requires NativeV12".into(),
        ));
    }
    bundle.validate().map_err(error)?;
    if source.kind != crate::definitions::bundle::SourceKind::Xtext
        || !bundle.sources.contains(source)
    {
        return Err(error(
            "Missing exact Xtext source for computed settings".into(),
        ));
    }
    let mut members = BTreeSet::new();
    for contract in contracts {
        contract.validate(schema, bundle).map_err(error)?;
        if !contract.sources.contains(&source.id) {
            return Err(error(
                "Computed setting contract omits the Xtext source".into(),
            ));
        }
        if !members.insert((&contract.class, &contract.feature)) {
            return Err(error(
                "Duplicate computed setting receiver/member contract".into(),
            ));
        }
    }
    Ok(())
}
#[cfg(feature = "text-compiler")]
fn compile_with_setting_declarations(
    source: &str,
    schema: &Schema,
    profile: Profile,
    declaration_limit: usize,
    contracts: Vec<crate::definitions::setting::ComputedSettingContract>,
    package_imports: std::rc::Rc<PackageImports>,
) -> Result<Grammar, Diagnostic> {
    let (mut grammar, _, spans, at) = parse_declarations(
        source,
        schema,
        profile,
        false,
        None,
        declaration_limit,
        package_imports,
    )?;
    grammar.computed_settings = contracts;
    if profile.has_rule_conversions() {
        let source = crate::definitions::bundle::DefinitionSource::new(
            "xtext",
            crate::definitions::bundle::SourceKind::Xtext,
            source,
        );
        grammar.declaration_sources = spans
            .into_iter()
            .map(|(name, span)| {
                (
                    name,
                    crate::definitions::bundle::SourceSpan {
                        source: source.id.clone(),
                        start: span.start,
                        end: span.end,
                    },
                )
            })
            .collect();
    }
    if profile.has_contextual_first_rule() {
        let authored = crate::definitions::bundle::DefinitionSource::new(
            "xtext",
            crate::definitions::bundle::SourceKind::Xtext,
            source,
        );
        let syntax = syntax::parse(
            &authored,
            SourceLimits {
                source_bytes: source.len(),
                declarations: declaration_limit,
            },
        )?;
        first_rule::validate_compiled(&syntax, &grammar, schema, Default::default())?;
    }
    validate_grammar(&mut grammar, schema).map_err(|e| Diagnostic::new("xtext", at, at + 1, e))?;
    Ok(grammar)
}

#[cfg(feature = "text-compiler")]
type ParsedDeclarations = (
    Grammar,
    Option<String>,
    BTreeMap<String, std::ops::Range<usize>>,
    usize,
);
#[cfg(feature = "text-compiler")]
fn parse_declarations(
    source: &str,
    schema: &Schema,
    profile: Profile,
    composition: bool,
    inherited_hidden: Option<Vec<String>>,
    declaration_limit: usize,
    package_imports: std::rc::Rc<PackageImports>,
) -> Result<ParsedDeclarations, Diagnostic> {
    let tokens = definition_tokens(source, profile, declaration_limit)?;
    let mut p = Parser {
            capture_origins: profile.has_durable_documents(),
        explicit_local_scope: matches!(
            profile,
            Profile::NativeV45
                | Profile::NativeV46
                | Profile::NativeV47
                | Profile::NativeV48
                | Profile::NativeV49
                | Profile::NativeV50
                | Profile::NativeV51
                | Profile::NativeV52
                | Profile::NativeV53
                | Profile::NativeV54
                | Profile::NativeV55
                | Profile::NativeV56
                | Profile::NativeV57
                | Profile::NativeV58
                | Profile::NativeV59
                | Profile::NativeV60
                | Profile::NativeV61
                | Profile::NativeV62
                | Profile::NativeV63
                | Profile::NativeV64 | Profile::NativeV65
        ),
        package_imports,
        allow_first_predicates: profile.has_parser_prediction(),
        allow_constant_guards: profile.has_constant_guards(),
        tokens,
        pos: 0,
        depth: 0,
        aliases: BTreeMap::new(),
        metamodel_imports: matches!(
            profile,
            Profile::NativeV20
                | Profile::NativeV21
                | Profile::NativeV22
                | Profile::NativeV23
                | Profile::NativeV24
                | Profile::NativeV25
                | Profile::NativeV26
                | Profile::NativeV27
                | Profile::NativeV28
                | Profile::NativeV29
                | Profile::NativeV30
                | Profile::NativeV31
                | Profile::NativeV32
                | Profile::NativeV33
                | Profile::NativeV34
                | Profile::NativeV35
                | Profile::NativeV36
                | Profile::NativeV37
                | Profile::NativeV38
                | Profile::NativeV39
                | Profile::NativeV40
                | Profile::NativeV41
                | Profile::NativeV42
                | Profile::NativeV43
                | Profile::NativeV44
                | Profile::NativeV45
                | Profile::NativeV46
                | Profile::NativeV47
                | Profile::NativeV48
                | Profile::NativeV49
                | Profile::NativeV50
                | Profile::NativeV51
                | Profile::NativeV52
                | Profile::NativeV53
                | Profile::NativeV54
                | Profile::NativeV55
                | Profile::NativeV56
                | Profile::NativeV57
                | Profile::NativeV58
                | Profile::NativeV59
                | Profile::NativeV60
                | Profile::NativeV61
                | Profile::NativeV62
                | Profile::NativeV63
                | Profile::NativeV64 | Profile::NativeV65
        ),
        hidden: None,
    };
    let result = (|| {
        let SourceHeader { name, parent, .. } = p.source_header(schema, composition)?;
        let grammar_name = name.clone();
        if p.hidden.is_none() {
            p.hidden = inherited_hidden;
        }
        // Xtext flattening gives a parentless grammar an empty policy. Exact
        // composition has already resolved any parent and its effective policy.
        // The single-source common.Terminals shortcut has no retained parent:
        // do not invent its hidden tokens or silently treat it as parentless.
        if matches!(
            profile,
            Profile::NativeV49
                | Profile::NativeV50
                | Profile::NativeV51
                | Profile::NativeV52
                | Profile::NativeV53
                | Profile::NativeV54
                | Profile::NativeV55
                | Profile::NativeV56
                | Profile::NativeV57
                | Profile::NativeV58
                | Profile::NativeV59
                | Profile::NativeV60
                | Profile::NativeV61
                | Profile::NativeV62
                | Profile::NativeV63
