fn predicted_lexeme(source:&str,start:usize,terminals:Option<&BTreeMap<String,Terminal>>,prediction:&LexerPrediction,work:&mut Option<usize>)->Result<Option<(usize,usize)>,(usize,String)>{
    let selected=prediction.predict_document(&source[start..],work).map_err(|e|(start,e))?;
    let lexer_prediction::LexicalDecision::Selected(index)=selected else{return Ok(None)};
    let end=selected_lexeme_end(source,start,terminals,prediction,index,work)?;Ok(Some((index,end)))
}
#[cfg(feature="text-compiler")]
fn selected_lexeme_end(source:&str,start:usize,terminals:Option<&BTreeMap<String,Terminal>>,prediction:&LexerPrediction,index:usize,work:&mut Option<usize>)->Result<usize,(usize,String)>{
    let end=match prediction.alternative(index).map_err(|e|(start,e))?{
        LexicalAlternative::Terminal(name)=>start+terminals.and_then(|v|v.get(name)).ok_or_else(||(start,"Missing predicted terminal".into()))?.match_len_with_work(&source[start..],work).map_err(|e|(start,e))?,
        LexicalAlternative::Keyword(text)=>{if !source[start..].starts_with(text){return Err((start,format!("Expected keyword {text}")))}start+text.len()}
    };Ok(end)

}
