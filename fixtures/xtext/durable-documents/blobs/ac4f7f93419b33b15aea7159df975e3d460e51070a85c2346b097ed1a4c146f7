        !self.fragment && self.datatype.is_none() && dispatch_shape(&self.body, grammar)
    }
}
#[cfg(feature = "text-compiler")]
fn dispatch_shape(expr: &Expr, grammar: &Grammar) -> bool {
    if matches!(
        grammar.profile,
        Profile::NativeV25
            | Profile::NativeV26
            | Profile::NativeV27
            | Profile::NativeV28
            | Profile::NativeV29
            | Profile::NativeV30
            | Profile::NativeV31
            | Profile::NativeV32
            | Profile::NativeV33
            | Profile::NativeV34
            | Profile::NativeV35
            | Profile::NativeV36
            | Profile::NativeV37
            | Profile::NativeV38
            | Profile::NativeV39
            | Profile::NativeV40
            | Profile::NativeV41
            | Profile::NativeV42
            | Profile::NativeV43
            | Profile::NativeV44
            | Profile::NativeV45
            | Profile::NativeV46
            | Profile::NativeV47
            | Profile::NativeV48
            | Profile::NativeV49
            | Profile::NativeV50
            | Profile::NativeV51
            | Profile::NativeV52
            | Profile::NativeV53
            | Profile::NativeV54
            | Profile::NativeV55
            | Profile::NativeV56
            | Profile::NativeV57
            | Profile::NativeV58
            | Profile::NativeV59
            | Profile::NativeV60
            | Profile::NativeV61
            | Profile::NativeV62
            | Profile::NativeV63
            | Profile::NativeV64 | Profile::NativeV65
    ) {
        return forwarding_count(expr, grammar) == Some(1);
    }
    if expr.cardinality != '1' {
        return false;
    }
    match &expr.kind {
        Kind::Call(name) => grammar
            .rules
            .get(name)
            .is_some_and(|rule| !rule.fragment && rule.datatype.is_none()),
        Kind::Sequence(items) => items.len() == 1 && dispatch_shape(&items[0], grammar),
        Kind::Alternative(items) => {
            !items.is_empty() && items.iter().all(|item| dispatch_shape(item, grammar))
        }
        _ => false,
    }
}
// Exactly one object-producing call on every path; surrounding keywords do
// not create an owner. Optional/repeated forwarding and writes remain excluded.
#[cfg(feature = "text-compiler")]
fn forwarding_count(expr: &Expr, grammar: &Grammar) -> Option<usize> {
    if expr.cardinality != '1' {
        return None;
    }
    match &expr.kind {
        Kind::Literal(_) => Some(0),
        Kind::Call(name) => grammar
            .rules
            .get(name)
            .filter(|rule| !rule.fragment && rule.datatype.is_none())
            .map(|_| 1),
        Kind::Sequence(items) => {
            let mut count = 0;
            for item in items {
                count += forwarding_count(item, grammar)?;
                if count > 1 {
                    return None;
                }
            }
            Some(count)
        }
        Kind::Alternative(items) => {
            let count = forwarding_count(items.first()?, grammar)?;
            items
                .iter()
                .all(|item| forwarding_count(item, grammar) == Some(count))
                .then_some(count)
        }
        _ => None,
    }
}
