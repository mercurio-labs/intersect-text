            let mut seen = BTreeSet::new();
            seen.insert(name.clone());
            check_left(&rule.body, grammar, &mut seen)?;
            check_prediction(
                &rule.body,
                grammar,
                &format!("rule/{name}"),
                &mut deferred_predictions,
            )?;
            Ok(())
