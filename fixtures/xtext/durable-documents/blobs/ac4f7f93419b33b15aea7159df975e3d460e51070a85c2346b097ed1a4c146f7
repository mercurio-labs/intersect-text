#[derive(Debug,Serialize)]
pub struct LexicalIssue {pub token:usize,pub utf16_start:usize,pub utf16_end:usize,pub utf16_lookahead:usize,pub unit:Option<u16>,pub expected:Option<u16>,pub selected_alternative:Option<usize>}
#[cfg(feature="text-compiler")]
#[derive(Debug,Serialize)]
pub struct DocumentTokenRange {pub utf16_start:usize,pub utf16_end:usize,pub utf8:Option<std::ops::Range<usize>>}
/// Same lexical predictor and committed terminal recognizer over the actual
/// source units. Interior scalar boundaries remain source-unit observations.
#[cfg(feature="text-compiler")]
#[allow(clippy::type_complexity)]
pub fn lex_document<'a>(source:&'a str,token_limit:Option<usize>,terminals:&BTreeMap<String,Terminal>,prediction:&LexerPrediction,work:&mut Option<usize>)->Result<(Vec<Token<Cow<'a,str>>>,Vec<LexicalIssue>,Vec<DocumentTokenRange>),(usize,String)>{
    let mut tokens=Vec::new();let mut issues=Vec::new();let mut ranges=Vec::new();
    let mut input=source.encode_utf16();let mut unit_at=0usize;let mut byte_at=0usize;let mut interior=false;
    while input.clone().next().is_some(){
        if token_limit.is_some_and(|limit|tokens.len()>=limit){return Err((byte_at,"Token budget exceeded".into()))}
        let decision=prediction.predict_document_units(input.clone(),work).map_err(|e|(byte_at,e))?;
        let (index,consumed,failure)=match decision{
            lexer_prediction::LexicalDecision::Selected(index)=>match prediction.alternative(index).map_err(|e|(byte_at,e))?{
                LexicalAlternative::Keyword(text)=>{let mut actual=input.clone();if !text.encode_utf16().all(|unit|actual.next()==Some(unit)){return Err((byte_at,"Predicted keyword does not match original source units".into()))}(Some(index),text.encode_utf16().count(),None)}
                LexicalAlternative::Terminal(name)=>match terminals.get(name).ok_or_else(||(byte_at,"Missing predicted terminal".into()))?.match_document_units(input.clone(),work).map_err(|e|(byte_at,e))?{
                    terminals::DocumentUnitMatch::Matched(end)=>(Some(index),end,None),
                    terminals::DocumentUnitMatch::Failed{consumed_units,failure}=>(None,consumed_units,Some((failure.utf16_offset,failure.actual,Some(failure.expected),Some(index)))),
                },
            },
            lexer_prediction::LexicalDecision::Unselected{utf16_lookahead,unit}=>(None,1,Some((utf16_lookahead,unit,None,None))),
        };
        if consumed==0{return Err((byte_at,"Non-consuming document lexical record".into()))}
        let unit_start=unit_at;let byte_start=byte_at;let start_interior=interior;let source_units=input.clone().take(consumed);
        for _ in 0..consumed{
            input.next().ok_or_else(||(byte_at,"Document lexical result escapes source units".into()))?;
            let ch=source.get(byte_at..).and_then(|s|s.chars().next()).ok_or_else(||(byte_at,"Missing original source scalar".into()))?;
            if interior{byte_at+=ch.len_utf8();interior=false}else if ch.len_utf16()==2{interior=true}else{byte_at+=ch.len_utf8()}
            unit_at=unit_at.checked_add(1).ok_or_else(||(byte_at,"Document source position overflow".into()))?;
        }
        let end_cover=if interior{byte_at+source[byte_at..].chars().next().ok_or_else(||(byte_at,"Missing interior scalar".into()))?.len_utf8()}else{byte_at};
        let exact_bytes=(!start_interior&&!interior).then_some(byte_start..byte_at);
        let text=if let Some(range)=&exact_bytes{Cow::Borrowed(&source[range.clone()])}else{
            // Display only. The exact units are retained by the source range;
            // this escaped rendering cannot authorize a scalar semantic value.
            Cow::Owned(source_units.map(|u|format!("\\u{u:04X}")).collect::<String>())
        };
        if let Some((utf16_lookahead,unit,expected,selected_alternative))=failure{issues.push(LexicalIssue{token:tokens.len(),utf16_start:unit_start,utf16_end:unit_at,utf16_lookahead,unit,expected,selected_alternative});}
        tokens.push(Token{text,start:byte_start,end:end_cover,quoted:false,lexical_alternative:index});ranges.push(DocumentTokenRange{utf16_start:unit_start,utf16_end:unit_at,utf8:exact_bytes});
    }
    Ok((tokens,issues,ranges))
}

