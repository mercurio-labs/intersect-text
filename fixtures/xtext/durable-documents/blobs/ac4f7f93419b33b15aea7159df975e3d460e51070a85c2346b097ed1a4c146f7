#[cfg(feature = "text-compiler")]
pub(crate) fn compile_with_reference_context_and_package_imports(
    source: &str,
    schema: &mut Schema,
    profile: Profile,
    declaration_limit: usize,
    package_imports: PackageImports,
) -> Result<Grammar, Diagnostic> {
    if profile.has_terminal_cardinality_decisions() {
        return Err(Diagnostic::new(
            "xtext",
            0,
            1,
            "NativeV63 requires an exact source bundle and language-owned authored-source validation",
        ));
    }
    let tokens = definition_tokens(source, profile, declaration_limit)?;
    let mut parser = Parser {
            capture_origins: false,
        explicit_local_scope: matches!(
            profile,
            Profile::NativeV45
                | Profile::NativeV46
                | Profile::NativeV47
                | Profile::NativeV48
                | Profile::NativeV49
                | Profile::NativeV50
                | Profile::NativeV51
                | Profile::NativeV52
                | Profile::NativeV53
                | Profile::NativeV54
                | Profile::NativeV55
                | Profile::NativeV56
                | Profile::NativeV57
                | Profile::NativeV58
                | Profile::NativeV59
                | Profile::NativeV60
                | Profile::NativeV61
                | Profile::NativeV62
                | Profile::NativeV63
                | Profile::NativeV64 | Profile::NativeV65
        ),
        package_imports: std::rc::Rc::new(package_imports),
        allow_first_predicates: profile.has_parser_prediction(),
        allow_constant_guards: profile.has_constant_guards(),
        tokens,
        pos: 0,
        depth: 0,
        aliases: BTreeMap::new(),
        metamodel_imports: matches!(
            profile,
            Profile::NativeV20
                | Profile::NativeV21
                | Profile::NativeV22
                | Profile::NativeV23
                | Profile::NativeV24
                | Profile::NativeV25
                | Profile::NativeV26
                | Profile::NativeV27
                | Profile::NativeV28
                | Profile::NativeV29
                | Profile::NativeV30
                | Profile::NativeV31
                | Profile::NativeV32
                | Profile::NativeV33
                | Profile::NativeV34
                | Profile::NativeV35
                | Profile::NativeV36
                | Profile::NativeV37
                | Profile::NativeV38
                | Profile::NativeV39
                | Profile::NativeV40
                | Profile::NativeV41
                | Profile::NativeV42
                | Profile::NativeV43
                | Profile::NativeV44
                | Profile::NativeV45
                | Profile::NativeV46
                | Profile::NativeV47
                | Profile::NativeV48
                | Profile::NativeV49
                | Profile::NativeV50
                | Profile::NativeV51
                | Profile::NativeV52
                | Profile::NativeV53
                | Profile::NativeV54
                | Profile::NativeV55
                | Profile::NativeV56
                | Profile::NativeV57
                | Profile::NativeV58
                | Profile::NativeV59
                | Profile::NativeV60
                | Profile::NativeV61
                | Profile::NativeV62
                | Profile::NativeV63
                | Profile::NativeV64 | Profile::NativeV65
        ),
        hidden: None,
    };
    parser.header(schema).map_err(|error| {
        let at = parser
            .tokens
            .get(parser.pos.saturating_sub(1))
            .map_or(0, |token| token.start);
        Diagnostic::new("xtext", at, at + 1, error)
    })?;
    let previous = (schema.reference_top.clone(), schema.revision.clone());
    let result = (|| {
        if parser
            .aliases
            .values()
            .flatten()
            .any(|namespace| namespace == crate::definitions::ecore::ECORE)
        {
            install_reference_top(schema).map_err(|error| Diagnostic::new("xtext", 0, 1, error))?;
        }
        schema
            .validate_reference_top()
            .map_err(|error| Diagnostic::new("xtext", 0, 1, error))?;
        compile_with_setting_declarations(
            source,
            schema,
            profile,
            declaration_limit,
            Vec::new(),
            std::rc::Rc::clone(&parser.package_imports),
        )
    })();
    if result.is_err() {
        schema.reference_top = previous.0;
        schema.revision = previous.1;
    }
    result
}

/// Prepare the canonical Ecore EObject reference context before binding exact
/// provider contracts for a grammar that imports Ecore. This changes the schema
/// revision once; ordinary grammar compilation uses the same idempotent operation.
/// It neither admits grammar constructs nor installs providers.
#[cfg(feature = "text-compiler")]
pub fn prepare_ecore_reference_context(schema: &mut Schema) -> Result<(), String> {
    install_reference_top(schema)
}

#[cfg(feature = "text-compiler")]
fn install_reference_top(schema: &mut Schema) -> Result<(), String> {
    use sha2::{Digest, Sha256};
    schema.validate_reference_top()?;
    if schema.reference_top.is_none() {
        schema.reference_top =
            Some(crate::definitions::schema::eobject_reference_top_declaration()?);
        let encoded = serde_json::to_vec(&(&schema.revision, &schema.reference_top))
            .map_err(|error| error.to_string())?;
        schema.revision = format!("{:x}", Sha256::digest(encoded));
    }
    Ok(())
}

