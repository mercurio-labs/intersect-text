#[cfg(feature = "text-compiler")]
fn first_inner(
    expr: &Expr,
    grammar: &Grammar,
    depth: usize,
    budget: &mut usize,
) -> Result<(BTreeSet<String>, bool), String> {
    if depth > 64 || *budget == 0 {
        return Err("Grammar prediction budget exceeded".into());
    }
    *budget -= 1;
    let (set, nullable) = match &expr.kind {
        Kind::Action(_) | Kind::Capture { .. } => (BTreeSet::new(), true),
        Kind::Literal(s) => ([format!("literal:{s}")].into(), false),
        Kind::Reference(_) => (["terminal:ID".into()].into(), false),
        Kind::ScalarReference { rule, .. } => {
            let rule = grammar
                .rules
                .get(rule)
                .ok_or_else(|| "Unknown datatype reference rule".to_string())?;
            first_inner(&rule.body, grammar, depth + 1, budget)?
        }
        Kind::Call(name) => match grammar.rules.get(name) {
            Some(rule) => first_inner(&rule.body, grammar, depth + 1, budget)?,
            None => ([format!("terminal:{name}")].into(), false),
        },
        Kind::Assign { value, .. } | Kind::BooleanAssign { value, .. } => {
            first_inner(value, grammar, depth + 1, budget)?
        }
        Kind::Sequence(items) => {
            let mut set = BTreeSet::new();
            let mut nullable = true;
            for item in items {
                let (next, empty) = first_inner(item, grammar, depth + 1, budget)?;
                set.extend(next);
                if !empty {
                    nullable = false;
                    break;
                }
            }
            (set, nullable)
        }
        Kind::Alternative(items) => {
            let mut set = BTreeSet::new();
            let mut nullable = false;
            for item in items {
                let (next, empty) = first_inner(item, grammar, depth + 1, budget)?;
                set.extend(next);
                nullable |= empty;
            }
            (set, nullable)
        }
    };
    Ok((set, nullable || ['?', '*'].contains(&expr.cardinality)))
}
#[cfg(feature = "text-compiler")]
fn overlaps(left: &BTreeSet<String>, right: &BTreeSet<String>) -> bool {
    if !left.is_disjoint(right) {
        return true;
    }
    let numeric = |set: &BTreeSet<String>| {
        set.iter().any(|s| {
            s.strip_prefix("literal:")
                .is_some_and(|s| s.chars().all(|c| c.is_ascii_digit()))
        })
    };
    (left.contains("terminal:INT") && numeric(right))
        || (right.contains("terminal:INT") && numeric(left))
}
// Only a guard on every entry path can resolve an enclosing decision.
#[cfg(feature = "text-compiler")]
fn visible_entry_guard(expr: &Expr) -> bool {
    if expr.first_set_predicated {
        return true;
    }
    match &expr.kind {
        Kind::Sequence(items) => items
            .first()
            .is_some_and(|item| item.cardinality == '1' && visible_entry_guard(item)),
        Kind::Assign { value, .. } | Kind::BooleanAssign { value, .. } => {
            visible_entry_guard(value)
        }
        _ => false,
    }
}
#[cfg(feature = "text-compiler")]
fn bind_prediction_paths(expr: &mut Expr, path: &str, predicates: &mut BTreeSet<String>, all: bool) {
    if expr.first_set_predicated {
        predicates.insert(path.into());
    }
    if all || matches!(&expr.kind, Kind::Alternative(items) if !items.is_empty())
        || matches!(expr.cardinality, '?' | '*' | '+')
    {
        expr.prediction_path = Some(path.into());
    }
    match &mut expr.kind {
        Kind::Sequence(items) => {
            for (index, item) in items.iter_mut().enumerate() {
                bind_prediction_paths(item, &format!("{path}/s{index}"), predicates, all);
            }
        }
        Kind::Alternative(items) => {
            for (index, item) in items.iter_mut().enumerate() {
                bind_prediction_paths(item, &format!("{path}/a{index}"), predicates, all);
            }
        }
        Kind::Assign { value, .. } | Kind::BooleanAssign { value, .. } => {
            bind_prediction_paths(value, &format!("{path}/value"), predicates, all)
        }
        _ => {}
    }
}
// Unquantified nullable wrappers introduce no skip decision of their own.
// The called fragment's FOLLOW and nested decision proofs remain mandatory.
#[cfg(feature = "text-compiler")]
fn is_structural_nullable_continuation(expr: &Expr, grammar: &Grammar) -> bool {
    matches!(
        grammar.profile,
        Profile::NativeV34
            | Profile::NativeV35
            | Profile::NativeV36
            | Profile::NativeV37
            | Profile::NativeV38
            | Profile::NativeV39
            | Profile::NativeV40
            | Profile::NativeV41
            | Profile::NativeV42
            | Profile::NativeV43
            | Profile::NativeV44
            | Profile::NativeV45
            | Profile::NativeV46
            | Profile::NativeV47
            | Profile::NativeV48
            | Profile::NativeV49
            | Profile::NativeV50
            | Profile::NativeV51
            | Profile::NativeV52
            | Profile::NativeV53
            | Profile::NativeV54
            | Profile::NativeV55
            | Profile::NativeV56
            | Profile::NativeV57
            | Profile::NativeV58
            | Profile::NativeV59
            | Profile::NativeV60
            | Profile::NativeV61
            | Profile::NativeV62
            | Profile::NativeV63
            | Profile::NativeV64 | Profile::NativeV65
    ) && expr.cardinality == '1'
        && match &expr.kind {
            Kind::Sequence(_)
            | Kind::Alternative(_)
            | Kind::Assign { .. }
            | Kind::BooleanAssign { .. } => true,
            Kind::Call(name) => grammar.rules.get(name).is_some_and(|rule| rule.fragment),
            _ => false,
        }
}
#[cfg(feature = "text-compiler")]
fn check_prediction(
    expr: &Expr,
    grammar: &Grammar,
    path: &str,
    deferred: &mut BTreeSet<String>,
) -> Result<(), String> {
    if ['*', '+'].contains(&expr.cardinality) {
        let mut once = expr.clone();
        once.cardinality = '1';
        if first(&once, grammar, 0)?.1 {
            return Err("Nullable repetitions are unsupported".into());
        }
    }
    match &expr.kind {
        Kind::Alternative(items) => {
            let mut previous: Vec<(&Expr, BTreeSet<String>)> = Vec::new();
            for (index, item) in items.iter().enumerate() {
                let (next, nullable) = first(item, grammar, 0)?;
                if nullable
                    && !matches!(
                        grammar.profile,
                        Profile::NativeV24
                            | Profile::NativeV25
                            | Profile::NativeV26
                            | Profile::NativeV27
                            | Profile::NativeV28
                            | Profile::NativeV29
                            | Profile::NativeV30
                            | Profile::NativeV31
                            | Profile::NativeV32
                            | Profile::NativeV33
                            | Profile::NativeV34
                            | Profile::NativeV35
                            | Profile::NativeV36
                            | Profile::NativeV37
                            | Profile::NativeV38
                            | Profile::NativeV39
                            | Profile::NativeV40
                            | Profile::NativeV41
                            | Profile::NativeV42
                            | Profile::NativeV43
                            | Profile::NativeV44
                            | Profile::NativeV45
                            | Profile::NativeV46
                            | Profile::NativeV47
                            | Profile::NativeV48
                            | Profile::NativeV49
                            | Profile::NativeV50
                            | Profile::NativeV51
                            | Profile::NativeV52
                            | Profile::NativeV53
                            | Profile::NativeV54
                            | Profile::NativeV55
                            | Profile::NativeV56
                            | Profile::NativeV57
                            | Profile::NativeV58
                            | Profile::NativeV59
                            | Profile::NativeV60
                            | Profile::NativeV61
                            | Profile::NativeV62
                            | Profile::NativeV63
                            | Profile::NativeV64 | Profile::NativeV65
                    )
                {
                    return Err(
                        "Overlapping or nullable alternatives require unsupported Xtext prediction"
                            .into(),
                    );
                }
                if nullable {
                    deferred.insert(format!("{path}/choice"));
                }
                for (earlier, head) in &previous {
                    if overlaps(head, &next)
                        && !(grammar.profile.has_parser_prediction()
                            && visible_entry_guard(earlier)
                            && earlier.cardinality == '1')
                    {
                        if matches!(
                            grammar.profile,
                            Profile::NativeV24
                                | Profile::NativeV25
                                | Profile::NativeV26
                                | Profile::NativeV27
                                | Profile::NativeV28
                                | Profile::NativeV29
                                | Profile::NativeV30
                                | Profile::NativeV31
                                | Profile::NativeV32
                                | Profile::NativeV33
                                | Profile::NativeV34
                                | Profile::NativeV35
                                | Profile::NativeV36
                                | Profile::NativeV37
                                | Profile::NativeV38
                                | Profile::NativeV39
                                | Profile::NativeV40
                                | Profile::NativeV41
                                | Profile::NativeV42
                                | Profile::NativeV43
                                | Profile::NativeV44
                                | Profile::NativeV45
                                | Profile::NativeV46
                                | Profile::NativeV47
                                | Profile::NativeV48
                                | Profile::NativeV49
                                | Profile::NativeV50
                                | Profile::NativeV51
                                | Profile::NativeV52
                                | Profile::NativeV53
                                | Profile::NativeV54
                                | Profile::NativeV55
                                | Profile::NativeV56
                                | Profile::NativeV57
                                | Profile::NativeV58
                                | Profile::NativeV59
                                | Profile::NativeV60
                                | Profile::NativeV61
                                | Profile::NativeV62
                                | Profile::NativeV63
                                | Profile::NativeV64 | Profile::NativeV65
                        ) {
                            deferred.insert(format!("{path}/choice"));
                        } else {
                            return Err("Overlapping or nullable alternatives require unsupported Xtext prediction".into());
                        }
                    }
                }
                previous.push((item, next));
                check_prediction(item, grammar, &format!("{path}/a{index}"), deferred)?;
            }
        }
        Kind::Sequence(items) => {
            for (index, item) in items.iter().enumerate() {
                check_prediction(item, grammar, &format!("{path}/s{index}"), deferred)?;
                if ['?', '*', '+'].contains(&item.cardinality) || first(item, grammar, 0)?.1 {
                    let (head, _) = first(item, grammar, 0)?;
                    for following in &items[index + 1..] {
                        let (tail, nullable) = first(following, grammar, 0)?;
                        if overlaps(&head, &tail)
                            && !(grammar.profile.has_parser_prediction()
                                && visible_entry_guard(item))
                        {
                            if matches!(
                                grammar.profile,
                                Profile::NativeV30
                                    | Profile::NativeV31
                                    | Profile::NativeV32
                                    | Profile::NativeV33
                                    | Profile::NativeV34
                                    | Profile::NativeV35
                                    | Profile::NativeV36
                                    | Profile::NativeV37
                                    | Profile::NativeV38
                                    | Profile::NativeV39
                                    | Profile::NativeV40
                                    | Profile::NativeV41
                                    | Profile::NativeV42
                                    | Profile::NativeV43
                                    | Profile::NativeV44
                                    | Profile::NativeV45
                                    | Profile::NativeV46
                                    | Profile::NativeV47
                                    | Profile::NativeV48
                                    | Profile::NativeV49
                                    | Profile::NativeV50
                                    | Profile::NativeV51
                                    | Profile::NativeV52
                                    | Profile::NativeV53
                                    | Profile::NativeV54
                                    | Profile::NativeV55
                                    | Profile::NativeV56
                                    | Profile::NativeV57
                                    | Profile::NativeV58
                                    | Profile::NativeV59
                                    | Profile::NativeV60
                                    | Profile::NativeV61
                                    | Profile::NativeV62
                                    | Profile::NativeV63
                                    | Profile::NativeV64 | Profile::NativeV65
                            ) && ['?', '*', '+'].contains(&item.cardinality)
                            {
                                deferred.insert(format!("{path}/s{index}/repeat"));
                            } else if is_structural_nullable_continuation(item, grammar) {
                                // FOLLOW validates nested repeats; nullable alternatives
                                // already require a shared-graph disjointness proof.
                            } else {
                                return Err("Repetition/optional follow conflict requires unsupported Xtext prediction".into());
                            }
                        }
                        if !nullable {
                            break;
                        }
                    }
                }
            }
        }
        Kind::Assign { value, .. } | Kind::BooleanAssign { value, .. } => {
            check_prediction(value, grammar, &format!("{path}/value"), deferred)?
        }
        _ => {}
    }
    Ok(())
}
#[cfg(feature = "text-compiler")]
fn check_left(expr: &Expr, grammar: &Grammar, seen: &mut BTreeSet<String>) -> Result<(), String> {
    check_left_inner(expr, grammar, seen, &mut 10_000)
}
#[cfg(feature = "text-compiler")]
fn check_left_inner(
    expr: &Expr,
    grammar: &Grammar,
    seen: &mut BTreeSet<String>,
    budget: &mut usize,
) -> Result<(), String> {
    if *budget == 0 || seen.len() > 64 {
        return Err("Grammar prediction budget exceeded".into());
    }
    *budget -= 1;
    match &expr.kind {
        Kind::Call(name) | Kind::ScalarReference { rule: name, .. } => {
            if let Some(rule) = grammar.rules.get(name) {
                if !seen.insert(name.clone()) {
                    return Err(format!("Left recursion through {name}"));
                }
                check_left_inner(&rule.body, grammar, seen, budget)?;
                seen.remove(name);
            }
        }
        Kind::Assign { value, .. } | Kind::BooleanAssign { value, .. } => {
            check_left_inner(value, grammar, seen, budget)?
        }
        Kind::Alternative(items) => {
            for item in items {
                check_left_inner(item, grammar, &mut seen.clone(), budget)?;
            }
        }
        Kind::Sequence(items) => {
            for item in items {
                check_left_inner(item, grammar, seen, budget)?;
                if !first(item, grammar, 0)?.1 {
                    break;
                }
            }
        }
        _ => {}
    }
    Ok(())
}

#[cfg(feature = "text-compiler")]
fn bind_reference_types(
    expression: &mut Expr,
    schema: &Schema,
    aliases: &BTreeMap<String, Vec<String>>,
    profile: Profile,
    imports: &PackageImports,
) -> Result<(), String> {
    match &mut expression.kind {
        Kind::Action(name) | Kind::Capture { class: name, .. } => {
            let (namespace, local) = imported_type(name, aliases, schema, profile, imports)?;
            *name = imported_class_key(schema, namespace, local)?.to_owned();
        }
        Kind::Reference(name) | Kind::ScalarReference { target: name, .. } => {
            let (namespace, local) = imported_type(name, aliases, schema, profile, imports)?;
            *name = if namespace == schema.uri || namespace == crate::definitions::ecore::ECORE {
                schema.language_reference_key(namespace, local)?
            } else {
                imported_class_key(schema, namespace, local)?
            }
            .to_owned();
        }
        Kind::Assign { value, .. } | Kind::BooleanAssign { value, .. } => {
            bind_reference_types(value, schema, aliases, profile, imports)?
        }
        Kind::Sequence(items) | Kind::Alternative(items) => {
            for item in items {
                bind_reference_types(item, schema, aliases, profile, imports)?;
            }
        }
        _ => {}
    }
    Ok(())
}

#[cfg(feature = "text-compiler")]
impl Grammar {
    /// Shared sorted keyword inventory for prediction, runtime and tooling.
    pub fn keywords(&self) -> Vec<String> {
        fn visit(expr: &Expr, out: &mut Vec<String>) {
            match &expr.kind {
                Kind::Literal(s) => {
                    if !out.contains(s) {
                        out.push(s.clone());
                    }
                }
                Kind::Assign { value, .. } | Kind::BooleanAssign { value, .. } => visit(value, out),
                Kind::Sequence(items) | Kind::Alternative(items) => {
                    for item in items {
                        visit(item, out);
                    }
                }
                _ => {}
            }
        }
        let mut out = Vec::new();
        for rule in self.rules.values() {
            visit(&rule.body, &mut out);
        }
        out.sort();
        out
    }
}
