                    let next = previous
                        .with_assignment(field, true)
                        .map_err(ParseError::Storage)?;
                    self.store
                        .set_assignment_state(&id, Some(next))
                        .map_err(ParseError::Storage)?;
                }
            }
        }
        if many {
            if let Some(length) = self
                .store
                .value_len(&id, field)
                .map_err(ParseError::Storage)?
            {
                return Ok(Some(length));
            }
        }
