#[derive(Debug)]
enum ParseError {
    Syntax(String),
    Budget(String),
    Storage(String),
}
impl ParseError {
    fn message(self) -> String {
        match self {
            Self::Syntax(message) | Self::Budget(message) | Self::Storage(message) => message,
        }
    }
}
// ModelStore savepoints own model rollback; this journal only restores parser-local references.
struct Undo<'a> {
    owner: usize,
    field: &'a str,
    unresolved: Option<usize>,
}
// Origin travels with the actual current-object slot, including rollback.
// An assigned child value uses a separate slot and cannot replace caller origin.
#[derive(Clone, Copy)]
struct Current {
    index: usize,
    delegated: bool,
}
impl Current {
    fn local(index: usize) -> Self {
        Self {
            index,
            delegated: false,
        }
    }
    fn called(index: usize) -> Self {
        Self {
            index,
            delegated: true,
        }
    }
}
