grammar document.provider.TypedRule hidden(WS)
import "urn:document-provider:paint:1" as p
import "http://www.eclipse.org/emf/2002/Ecore" as ecore
Paint returns p::Paint: 'paint' color=Color?;
Color returns ecore::EJavaObject: COLOR;
terminal COLOR returns ecore::EString: '#' ('0'..'9'|'a'..'f')+;
terminal WS returns ecore::EString: ' '+;
