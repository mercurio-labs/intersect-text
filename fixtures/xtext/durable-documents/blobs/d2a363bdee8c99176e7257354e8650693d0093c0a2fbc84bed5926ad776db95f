grammar example.CurrentActions hidden(WS)
import "urn:intersect:xtext:current-actions:1" as k
import "http://www.eclipse.org/emf/2002/Ecore" as Ecore
Model returns k::Model: name=ID '=' value=Expression ';';
Expression returns k::Expression: Literal ({k::OperatorExpression.operand += current} operator=AdditiveOperator operand+=Literal)*;
Literal returns k::Literal: value=INT;
AdditiveOperator: '+' | '-';
terminal ID: ('a'..'z'|'A'..'Z'|'_') ('a'..'z'|'A'..'Z'|'0'..'9'|'_')*;
terminal INT returns Ecore::EInt: ('0'..'9')+;
terminal WS: (' '|'\t'|'\r'|'\n')+;
