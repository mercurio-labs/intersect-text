  for(snapshot,source)in documents.iter_mut().zip(sources){if snapshot.document.source()!=&SourceId::for_text(&source.uri,&source.text){return Err("Document snapshot source order/identity mismatch".into())}
   let resource=model.resources.get(&source.uri).ok_or("Missing analyzed resource record")?;
   // bind_resource consumes the immutable arena, so the completed source-owned
   // snapshot is replaced in the vector only by its returned validated value.
   snapshot.bind_model(&model,&package.schema,self.limits)?;
   if resource.uri!=snapshot.document.source().uri||resource.source.as_ref().is_none_or(|s|s.uri!=snapshot.document.source().uri||s.revision!=snapshot.document.source().sha256){return Err("Document resource lacks exact source correspondence".into())}
  }
  // Resource revisions are assigned by actual shared model lifecycle, never a
  // caller-supplied serialized node arena. Move each arena through its binder.
  let mut bound=Vec::new();for mut snapshot in documents{let resource=model.resources.get(&snapshot.document.source().uri).ok_or("Missing document resource")?;snapshot.document=snapshot.document.bind_resource(resource)?;bound.push(snapshot);}
