impl DocumentLanguage {
 pub fn analyze(&self,source:&Source,selected_entry:Option<&str>,limits:EvaluationLimits)->Result<DocumentAnalysis,String>{
  self.analyze_with_context(source,selected_entry,limits,None,None,&query::PackageDerived(self.package()))
 }
 pub fn analyze_with_context(&self,source:&Source,selected_entry:Option<&str>,limits:EvaluationLimits,conversions:Option<&intersect_model::definitions::conversion::ConversionRegistry<'_>>,settings:Option<&setting::TextSettings<'_>>,derived:&dyn query::DerivedValues)->Result<DocumentAnalysis,String>{
  let mut all=self.analyze_sources_with_context(std::slice::from_ref(source),selected_entry,limits,conversions,settings,derived)?;
  if all.snapshots.len()!=1{return Err("Single document analysis did not return exactly one snapshot".into())}
  let snapshot=all.snapshots.pop().ok_or("Missing document snapshot")?;Ok(DocumentAnalysis{snapshot,diagnostics:all.diagnostics,valid_model:all.valid_model,recovered:all.recovered})
 }
 pub fn analyze_sources(&self,sources:&[Source],selected_entry:Option<&str>,limits:EvaluationLimits)->Result<DocumentAnalysisSet,String>{
  self.analyze_sources_with_context(sources,selected_entry,limits,None,None,&query::PackageDerived(self.package()))
 }
 pub fn analyze_sources_with_context(&self,sources:&[Source],selected_entry:Option<&str>,limits:EvaluationLimits,conversions:Option<&intersect_model::definitions::conversion::ConversionRegistry<'_>>,settings:Option<&setting::TextSettings<'_>>,derived:&dyn query::DerivedValues)->Result<DocumentAnalysisSet,String>{
  if let Some(entry)=selected_entry {if !self.entry.entries().contains_key(entry){return Err(format!("No emitted no-argument parser entry for {entry}"))}}
  if sources.len()>self.limits.resources{return Err("Document source resource budget exceeded".into())}
  let mut identities=BTreeSet::new();let mut bytes=0usize;
  for source in sources{intersect_model::core::resources::validate_resource_uri(&source.uri)?;if !identities.insert(source.uri.as_str()){return Err("Duplicate document source URI".into())}
   bytes=bytes.checked_add(source.uri.len()).and_then(|v|v.checked_add(source.text.len())).and_then(|v|v.checked_add(std::mem::size_of::<DocumentSnapshot>())).ok_or("Document source aggregate storage overflow")?;
   if source.text.len()>self.limits.tree.source_bytes||bytes>self.limits.total_source_bytes{return Err("Document source byte budget exceeded".into())}
  }
  let package=self.package();let mut store=storage::MemoryStore::with_index_policy(evaluation_index_policy(package));let mut documents=Vec::new();
  let result=storage::atomic(&mut store,|store|evaluate_staged(package,sources,Invocation{limits,entry:selected_entry,values:None,documents:Some(Request{origins:Arc::clone(&self.origins),limits:self.limits,output:&mut documents})},store,conversions,settings,derived))?;
