pub(crate) struct Request<'a>{origins:Arc<Origins>,limits:AnalysisLimits,output:&'a mut Vec<DocumentSnapshot>}
impl Request<'_>{
 pub(crate) fn limits(&self)->AnalysisLimits{self.limits}
