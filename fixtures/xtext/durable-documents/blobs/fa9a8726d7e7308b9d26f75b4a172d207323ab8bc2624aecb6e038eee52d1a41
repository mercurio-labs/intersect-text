#[derive(Clone,Copy,Debug,Default,Serialize)]
struct AssociationUsage{bytes:usize,records:usize,operations:usize}
impl AssociationUsage {
 fn admit(&mut self,limits:AnalysisLimits,bytes:usize,records:usize)->Result<(),String>{
  let operations=self.operations.checked_add(1).ok_or("Document association operation overflow")?;
  if operations>limits.association_operations{return Err("Document association operation budget exceeded".into())}
  let bytes=self.bytes.checked_add(bytes).ok_or("Document association storage overflow")?;
  let records=self.records.checked_add(records).ok_or("Document association record overflow")?;
  if bytes>limits.association_bytes||records>limits.association_records{return Err("Document association budget exceeded".into())}
  *self=Self{bytes,records,operations};Ok(())
 }
}
fn kind(expr:&Expr)->Option<OriginKind>{match expr.kind{Kind::Literal(_)=>Some(OriginKind::Keyword),Kind::Call(_)=>Some(OriginKind::RuleCall),Kind::Reference(_)|Kind::ScalarReference{..}=>Some(OriginKind::CrossReference),Kind::Action(_)|Kind::Capture{..}=>Some(OriginKind::Action),_=>None}}
fn original_source<'a>(p:&'a Package,id:&SourceId)->Result<&'a str,String>{
 if let Some(s)=p.compilation.as_ref().and_then(|c|c.bundle.sources.iter().find(|s|s.id==*id)){return Ok(&s.text)}
 if let Some(s)=p.xtext_inference.as_ref().and_then(|c|c.bundle.sources.iter().find(|s|s.id==*id)){return Ok(&s.text)}
 if let Some(s)=p.sources.get(&id.uri).filter(|s|SourceId::for_text(&id.uri,s)==*id){return Ok(s)}
 Err("Missing exact grammar source for document origin".into())
}
impl Origins {
 fn prepare(p:&Package,limits:AnalysisLimits)->Result<Self,String>{
  let g=p.grammar.as_ref().ok_or("Document language needs a text grammar")?;
  let mut out=Self{entries:Vec::new(),by_key:BTreeMap::new()};let mut budget=AssociationUsage::default();
  let mut add=|key:String,origin:GrammarOrigin|->Result<(),String>{
   let payload=origin.declaration.iter().chain(origin.expression.iter()).chain(origin.target.iter()).map(|s|s.source.uri.len()+s.source.sha256.len()).sum::<usize>()+origin.builtin.as_ref().map_or(0,String::len);
   budget.admit(limits,std::mem::size_of::<GrammarOrigin>()+std::mem::size_of::<(String,usize)>()+key.len()+payload,1)?;
   if out.by_key.insert(key,out.entries.len()).is_some(){return Err("Duplicate document origin occurrence".into())}out.entries.push(origin);Ok(())
  };
  for (name,rule) in &g.rules{
   let declaration=g.declaration_sources.get(name).cloned().ok_or("Missing exact parser declaration origin")?;let text=original_source(p,&declaration.source)?;
   if declaration.start>declaration.end||declaration.end>text.len(){return Err("Parser declaration escapes exact source".into())}
   add(format!("rule/{name}/declaration"),GrammarOrigin{kind:OriginKind::ParserRule,declaration:Some(declaration.clone()),expression:None,target:None,builtin:None})?;
   let mut pending=vec![(&rule.body,0usize)];
   while let Some((expr,depth))=pending.pop(){
    if depth>64{return Err("Document origin depth exceeded".into())}
    if let Some(kind)=kind(expr){
     let range=expr.original_range.as_ref().ok_or("Missing same-parser expression origin")?;
     if range.start<declaration.start||range.end>declaration.end||text.get(range.clone()).is_none(){return Err("Expression origin escapes exact declaration".into())}
     let path=expr.prediction_path.as_ref().ok_or("Missing exact compiled occurrence path")?;
     let target=match &expr.kind{Kind::Call(name)|Kind::ScalarReference{rule:name,..}=>g.declaration_sources.get(name).cloned(),_=>None};
     add(path.clone(),GrammarOrigin{kind,declaration:Some(declaration.clone()),expression:Some(SourceSpan{source:declaration.source.clone(),start:range.start,end:range.end}),target,builtin:None})?;
    }
    match &expr.kind{Kind::Sequence(items)|Kind::Alternative(items)=>for item in items.iter().rev(){pending.push((item,depth+1));},Kind::Assign{value,..}|Kind::BooleanAssign{value,..}=>pending.push((value,depth+1)),_=>{}}
   }
  }
  for name in g.terminals.keys().map(String::as_str).chain(["ID","INT","STRING"]).collect::<BTreeSet<_>>(){
   let key=format!("terminal/{name}");
   let declaration=g.declaration_sources.get(name).cloned();
   add(key,GrammarOrigin{kind:OriginKind::TerminalRule,declaration,expression:None,target:None,builtin:(!g.declaration_sources.contains_key(name)).then(||name.to_owned())})?;
  }
  Ok(out)
 }
 fn get(&self,key:&str)->Result<usize,String>{self.by_key.get(key).copied().ok_or_else(||format!("Missing exact document grammar occurrence {key}"))}
}
