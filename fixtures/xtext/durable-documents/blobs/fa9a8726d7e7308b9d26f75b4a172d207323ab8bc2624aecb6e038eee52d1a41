fn append_error_unit(units:&mut Vec<u16>,unit:Option<u16>){match unit{None=>units.extend("<EOF>".encode_utf16()),Some(10)=>units.extend("\\n".encode_utf16()),Some(13)=>units.extend("\\r".encode_utf16()),Some(9)=>units.extend("\\t".encode_utf16()),Some(unit)=>units.push(unit)}}
