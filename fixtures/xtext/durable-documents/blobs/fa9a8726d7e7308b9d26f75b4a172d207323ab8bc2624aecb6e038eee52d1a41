   Ok(DocumentAnalysisSet{snapshots:bound,diagnostics:Vec::new(),valid_model:Some(Evaluation{model,diagnostics,references:result.references,derived:result.derived}),recovered:None})
  }else{
   let recovered=RecoveredGraph{schema_revision:model.schema_revision,objects:model.elements.into_iter().map(|element|RecoveredObject{element}).collect(),resources:model.resources};
   Ok(DocumentAnalysisSet{snapshots:bound,diagnostics,valid_model:None,recovered:Some(recovered)})
  }
 }
