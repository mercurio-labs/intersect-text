#[derive(Serialize)]
pub struct NodeDiagnostic<'a>{pub source:&'a SourceId,pub node:NodeId,pub utf16:TextRange,pub utf8:Option<TextRange>,pub issue:&'a SyntaxIssue}
impl DocumentSnapshot {
 pub fn document(&self)->&TextDocument{&self.document}
 pub fn syntax_issues(&self)->&[SyntaxIssue]{&self.syntax_issues}
 pub fn lexical_issues(&self)->&[grammar::LexicalIssue]{&self.lexical_issues}
 pub fn feature_nodes(&self)->&[FeatureNode]{&self.feature_nodes}
 pub fn semantic_objects(&self)->&[SemanticObjectIdentity]{&self.semantic_objects}
 pub fn schema_revision(&self)->&str{&self.schema_revision}
 pub fn parse_stage(&self)->&ParseStage{&self.parse_stage}
 pub fn prediction_dependencies(&self)->&[PredictionDependency]{&self.prediction_dependencies}
 pub fn tree_usage(&self)->DocumentUsage{self.tree_usage}
 /// Resolve an owned node through the actual unchanged resource/schema identity.
 /// This never imports an observed arena or publishes a recovered object graph.
 pub fn linked_object<'m>(&self,handle:&intersect_model::core::text_document::NodeHandle,model:&'m Model,schema:&intersect_model::definitions::schema::Schema)->Result<Option<&'m intersect_model::core::model::Element>,String>{
  self.document.node(handle)?;
  if schema.revision!=self.schema_revision||model.schema_revision!=self.schema_revision{return Err("Document model links require the exact schema revision".into())}
  let resource=model.resources.get(&self.document.source().uri).ok_or("Document model resource is absent")?;self.document.check_resource(resource)?;
  let Some(index)=self.semantic_object(handle.node)?else{return Ok(None)};let expected=self.semantic_objects.get(index).ok_or("Unknown document semantic identity")?;
  if schema.declarations.get(&expected.class)!=Some(&expected.classifier)||schema.instantiations.get(&expected.class)!=expected.runtime_type.as_ref(){return Err("Document classifier source identity changed".into())}
  let mut found=None;for element in &model.elements{if element.id==expected.id{if found.is_some(){return Err("Ambiguous document model object identity".into())}found=Some(element);}}
  let element=found.ok_or("Document model object is absent")?;
  if element.resource!=self.document.source().uri||element.class!=expected.class||element.type_identity!=schema.identity(&expected.class){return Err("Document model object source/class identity changed".into())}
  Ok(Some(element))
 }
 pub fn syntax_diagnostics(&self)->impl Iterator<Item=Result<NodeDiagnostic<'_>,String>>{
  self.document.nodes().iter().enumerate().filter_map(|(index,node)|node.data.syntax_error.map(|issue|(index,node,issue))).map(|(index,node,issue)|Ok(NodeDiagnostic{source:self.document.source(),node:NodeId(index),utf16:node.range,utf8:self.document.utf8_range(node.range)?,issue:self.syntax_issues.get(issue).ok_or("Unknown source-bound syntax diagnostic")?}))
 }
 pub fn origins(&self)->&[GrammarOrigin]{&self.origins.entries}
 pub fn semantic_object(&self,node:NodeId)->Result<Option<usize>,String>{
  let mut next=Some(node);let mut remaining=self.document.nodes().len();
  while let Some(id)=next{if remaining==0{return Err("Cyclic document parent links".into())}remaining-=1;let n=self.document.nodes().get(id.0).ok_or("Unknown document node")?;if n.data.semantic_object.is_some(){return Ok(n.data.semantic_object)}next=n.parent;}Ok(None)
 }
}
impl DocumentSnapshot {
 /// Conservative source/node invalidation. No model mutation or incremental
 /// reparse is authorized by this query; reparsing uses the same shared Machine.
 pub fn invalidated_nodes(&self,resource:&intersect_model::core::resources::ResourceRecord,edit:TextRange,limits:InvalidationLimits)->Result<Vec<NodeId>,String>{
  self.document.check_resource(resource)?;let _checked=self.document.units_in(edit)?;
  let mut remaining=limits.operations;let mut selected=BTreeSet::new();
  let mut visit=|at:Option<NodeId>|->Result<(),String>{if remaining==0{return Err("Document invalidation operation budget exceeded".into())}remaining-=1;let mut next=at;while let Some(node)=next{if remaining==0{return Err("Document invalidation operation budget exceeded".into())}remaining-=1;let row=self.document.nodes().get(node.0).ok_or("Invalid prediction dependency node")?;if !selected.contains(&node.0){if selected.len()>=limits.nodes{return Err("Document invalidation node budget exceeded".into())}selected.insert(node.0);}next=row.parent;}Ok(())};
  for(index,node)in self.document.nodes().iter().enumerate(){visit((node.total_range.start<=edit.end&&edit.start<=node.total_range.end).then_some(NodeId(index)))?;}
  for dependency in &self.prediction_dependencies{visit((dependency.range.start<=edit.end&&edit.start<=dependency.range.end).then_some(dependency.node))?;}
  Ok(selected.into_iter().map(NodeId).collect())
 }
}
impl Capture {
 fn new(source:&Source,revision:u64,origins:Arc<Origins>,limits:AnalysisLimits)->Result<Self,String>{
  // Source admission precedes its only owned copy and the builder's digest.
  if source.text.len()>limits.tree.source_bytes{return Err("Document source byte budget exceeded".into())}
  let builder=DocumentBuilder::from_source(&source.uri,&source.text,revision,limits.tree)?;
  Ok(Self{builder,origins,frames:Vec::new(),frame_undo:Vec::new(),emitted:0,issues:Vec::new(),features:Vec::new(),dependencies:Vec::new(),feature_undo:Vec::new(),calls:Vec::new(),lexical_issues:Vec::new(),token_ranges:Vec::new(),unit_messages:Vec::new(),failure_message:None,pending_error:None,recovering:false,recovered_match:false,last_error_index:None,limits,usage:AssociationUsage::default()})
 }
 pub(crate) fn mark(&mut self)->Result<Mark,String>{Ok(Mark{tree:self.builder.mark()?,emitted:self.emitted,issues:self.issues.len(),features:self.features.len(),dependencies:self.dependencies.len(),feature_undo:self.feature_undo.len(),frames:self.frames.len(),frame_undo:self.frame_undo.len(),pending_error:self.pending_error,recovering:self.recovering,recovered_match:self.recovered_match,last_error_index:self.last_error_index,unit_messages:self.unit_messages.len(),failure_message:self.failure_message})}
 pub(crate) fn check_mark(&self,mark:&Mark)->Result<(),String>{self.builder.check_mark(&mark.tree)}
 pub(crate) fn commit(&mut self,mark:Mark)->Result<(),String>{self.builder.commit(mark.tree)}
 pub(crate) fn rollback(&mut self,mark:Mark)->Result<(),String>{self.builder.rollback(mark.tree)?;self.emitted=mark.emitted;self.issues.truncate(mark.issues);self.features.truncate(mark.features);self.dependencies.truncate(mark.dependencies);while self.feature_undo.len()>mark.feature_undo{let(index,node)=self.feature_undo.pop().ok_or("Missing document feature undo")?;if index<mark.features{self.features.get_mut(index).ok_or("Missing original document feature")?.node=node;}}while self.frame_undo.len()>mark.frame_undo{let(index,frame)=self.frame_undo.pop().ok_or("Missing document frame undo")?;if index<mark.frames{*self.frames.get_mut(index).ok_or("Missing original document frame")?=frame;}}self.frames.truncate(mark.frames);self.pending_error=mark.pending_error;self.recovering=mark.recovering;self.recovered_match=mark.recovered_match;self.last_error_index=mark.last_error_index;self.unit_messages.truncate(mark.unit_messages);self.failure_message=mark.failure_message;Ok(())}
 pub(crate) fn begin(&mut self,key:&str,at:usize)->Result<NodeId,String>{
  self.usage.admit(self.limits,std::mem::size_of::<Frame>(),1)?;
  let node=self.builder.begin(at,NodeData{origin:Some(self.origins.get(key)?),..NodeData::default()})?;
  self.frames.push(Frame{node,anchor:node,fallback:at});Ok(node)
 }
 pub(crate) fn close(&mut self,node:NodeId)->Result<(),String>{
  let frame=self.frames.last().ok_or("Missing document frame")?;if frame.anchor!=node{return Err("Document parser frame mismatch".into())}
  self.builder.close_from_children(frame.node,frame.fallback)?;self.frames.pop();Ok(())
 }
 pub(crate) fn action(&mut self,key:&str)->Result<NodeId,String>{
  let index=self.frames.len().checked_sub(1).ok_or("Missing action document frame")?;let before=self.frames[index];
  let mut links=0usize;for feature in &self.features{self.usage.admit(self.limits,0,0)?;self.usage.admit(self.limits,0,0)?;if feature.node==before.node{links=links.checked_add(1).ok_or("Document action feature count overflow")?;}}
  let bytes=links.checked_mul(std::mem::size_of::<(usize,NodeId)>()).and_then(|n|n.checked_add(std::mem::size_of::<(usize,Frame)>())).ok_or("Document action association storage overflow")?;
  self.usage.admit(self.limits,bytes,links.checked_add(1).ok_or("Document action association record overflow")?)?;
  let node=self.builder.wrap_open(before.node,NodeData{origin:Some(self.origins.get(key)?),..NodeData::default()})?;
  for(index,feature)in self.features.iter_mut().enumerate(){if feature.node==before.node{self.feature_undo.push((index,feature.node));feature.node=node;}}
  self.frame_undo.push((index,before));self.frames[index].node=node;Ok(before.node)
 }
 pub(crate) fn push_call(&mut self,path:&str)->Result<(),String>{
  if self.calls.len()>=128{return Err("Document recovery call depth exceeded".into())}
  self.usage.admit(self.limits,std::mem::size_of::<String>()+path.len(),1)?;self.calls.push(path.to_owned());Ok(())
 }
 pub(crate) fn associate(&mut self,object:usize)->Result<(),String>{
  let frame=self.frames.last().ok_or("Missing semantic document frame")?;let mut data=self.builder.node_data(frame.node)?;data.semantic_object=Some(object);data.direct_semantic_association=true;self.builder.set_data(frame.node,data)
 }
 pub(crate) fn feature(&mut self,owner:&str,feature:&str,node:NodeId)->Result<(),String>{
  self.usage.admit(self.limits,std::mem::size_of::<FeatureNode>()+owner.len()+feature.len(),1)?;self.features.push(CapturedFeature{owner:owner.into(),feature:feature.into(),node});Ok(())
 }
 pub(crate) fn prediction(&mut self,path:&str,start:usize,after:usize,hidden:&[String])->Result<(),String>{
  if start==after{return Ok(())}
  let node=self.frames.last().ok_or("Missing actual prediction document frame")?.node;
  let eof=self.token_ranges.last().map_or(0,|r|r.utf16_end);let reached_end=after>self.token_ranges.len();
  let range=TextRange{start:self.token_ranges.get(start).map_or(eof,|r|r.utf16_start),end:if reached_end{eof}else{self.token_ranges.get(after.checked_sub(1).ok_or("Invalid prediction cursor")?).ok_or("Prediction cursor escapes retained token stream")?.utf16_end}};
  let payload=hidden.iter().try_fold(path.len(),|n,value|n.checked_add(std::mem::size_of::<String>()).and_then(|n|n.checked_add(value.len())).ok_or("Prediction dependency storage overflow"))?;
  self.usage.admit(self.limits,payload.checked_add(std::mem::size_of::<PredictionDependency>()).ok_or("Prediction dependency storage overflow")?,1)?;
  self.dependencies.push(PredictionDependency{node,occurrence:path.into(),range,reached_end,hidden_policy:hidden.to_vec()});Ok(())
 }
 pub(crate) fn lexical_issues(&mut self,issues:Vec<grammar::LexicalIssue>,ranges:Vec<grammar::DocumentTokenRange>)->Result<(),String>{
  self.usage.admit(self.limits,issues.len().checked_mul(std::mem::size_of::<grammar::LexicalIssue>()).ok_or("Document lexical size overflow")?,issues.len())?;self.usage.admit(self.limits,ranges.len().checked_mul(std::mem::size_of::<grammar::DocumentTokenRange>()).ok_or("Document token range storage overflow")?,ranges.len())?;self.lexical_issues=issues;self.token_ranges=ranges;Ok(())
 }
 pub(crate) fn token_range(&self,index:usize)->Option<TextRange>{self.token_ranges.get(index).map(|r|TextRange{start:r.utf16_start,end:r.utf16_end})}
 pub(crate) fn token_positions(&self)->Vec<usize>{self.token_ranges.iter().map(|r|r.utf16_start).collect()}
 pub(crate) fn scalar_token(&self,index:usize)->bool{self.token_ranges.get(index).is_some_and(|r|r.utf8.is_some())}
 pub(crate) fn lexical_leaf(&mut self,index:usize,range:TextRange)->Result<Option<NodeId>,String>{
  let Some(issue)=self.lexical_issues.iter().find(|e|e.token==index)else{return Ok(None)};
  let prefix=if issue.expected.is_some(){"mismatched character '"}else{"no viable alternative at character '"};
  let mut units:Vec<u16>=prefix.encode_utf16().collect();append_error_unit(&mut units,issue.unit);
  if let Some(expected)=issue.expected{units.extend("' expecting '".encode_utf16());append_error_unit(&mut units,Some(expected));}units.push(39);
  let(message,message_utf16)=unit_message(units);
  self.usage.admit(self.limits,std::mem::size_of::<SyntaxIssue>()+message.len()+message_utf16.as_ref().map_or(0,|v|v.len()*2),1)?;let error=self.issues.len();self.issues.push(SyntaxIssue{message,message_utf16,range,expected:None,recovery:Recovery::Lexical});
  Ok(Some(self.builder.leaf(range,NodeData{origin:None,hidden:true,syntax_error:Some(error),..NodeData::default()})?))
 }
 pub(crate) fn token_message(&mut self,index:usize,prefix:&str,suffix:&str)->Result<String,String>{
  let range=self.token_range(index);let source_units=range.map_or(5,|r|r.end-r.start);let units=prefix.encode_utf16().count().checked_add(source_units.checked_mul(2).ok_or("Diagnostic unit count overflow")?).and_then(|v|v.checked_add(suffix.encode_utf16().count())).ok_or("Diagnostic unit count overflow")?;
  self.usage.admit(self.limits,units.checked_mul(10).and_then(|v|v.checked_add(std::mem::size_of::<(String,Vec<u16>)>())).ok_or("Diagnostic unit storage overflow")?,1)?;
  let mut message:Vec<u16>=prefix.encode_utf16().collect();
  if let Some(range)=range{for unit in self.builder.source_units(range)?{append_error_unit(&mut message,Some(unit));}}else{message.extend("<EOF>".encode_utf16())}
  message.extend(suffix.encode_utf16());let(display,raw)=unit_message(message);self.failure_message=None;
  if let Some(raw)=raw{self.failure_message=Some(self.unit_messages.len());self.unit_messages.push((display.clone(),raw));}
  Ok(display)
 }
 pub(crate) fn matched(&mut self){if self.recovered_match{self.recovered_match=false}else{self.recovering=false;}}
 pub(crate) fn report(&mut self,message:String,range:TextRange,expected:Option<String>,recovery:Recovery,force:bool)->Result<(),String>{
  if self.pending_error.is_some()||(self.recovering&&!force){return Ok(())}
  let was_recovering=self.recovering;
  self.issue(message,range,expected,recovery)?;
  // Generated rule catches invoke recover directly, not reportError. The
  // pinned recover helper attaches currentError without entering report suppression.
  self.recovering=if force{was_recovering}else{true};Ok(())
 }
 pub(crate) fn issue(&mut self,message:String,range:TextRange,expected:Option<String>,recovery:Recovery)->Result<usize,String>{
  self.usage.admit(self.limits,std::mem::size_of::<SyntaxIssue>()+message.len()+expected.as_ref().map_or(0,String::len),1)?;let id=self.issues.len();let message_utf16=if let Some(index)=self.failure_message.take(){let(display,raw)=self.unit_messages.get(index).ok_or("Unknown source-unit diagnostic message")?;if *display==message{self.usage.admit(self.limits,raw.len().checked_mul(2).ok_or("Diagnostic unit storage overflow")?,1)?;Some(raw.clone())}else{None}}else{None};self.issues.push(SyntaxIssue{message,message_utf16,range,expected,recovery});self.pending_error=Some(id);Ok(id)
 }
