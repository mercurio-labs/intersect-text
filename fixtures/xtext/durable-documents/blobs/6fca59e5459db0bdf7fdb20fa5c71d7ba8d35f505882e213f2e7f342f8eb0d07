from pathlib import Path
import gzip,json,hashlib,io
N=Path(__file__).resolve().parent;O=N/'portable-v65-evidence-v1';B=N.parent/'rcore-xtext-support-evidence/string-v64-actual-public-v2';entries={}
def pin(b):return {'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}
def add(data,name,role):
