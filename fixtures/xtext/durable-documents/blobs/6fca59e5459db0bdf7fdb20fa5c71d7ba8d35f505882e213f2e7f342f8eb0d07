for name in ['receipt.json','preexecution.json']:add((B/name).read_bytes(),'baseline-original/'+name,'unchanged-original-baseline-provenance')
add(Path(__file__).read_bytes(),'producer-original/add-portable-v65-original2147-baseline-v1.py','verification-storage-adapter')
for name,value in [('origins-addendum-v3.json',entries),('original2147-storage.json',{'source_original_relative_lineage':'rcore-xtext-support-evidence/string-v64-actual-public-v2/record.jsonl','raw':pin(raw),'gzip':pin(packed),'origin':'baseline-original/original2147.jsonl.gz','storage_only':'New deterministic gzip, filename empty/mtime0; decompress to exact unchanged complete original50MB native baseline. No request/result/identity/order normalization.'})]:
    with(O/name).open('x',encoding='utf-8',newline='\n')as f:f.write(json.dumps(value,ensure_ascii=True,indent=2)+'\n')
