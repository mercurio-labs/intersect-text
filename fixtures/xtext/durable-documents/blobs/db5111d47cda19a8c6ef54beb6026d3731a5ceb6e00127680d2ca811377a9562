#[test]
fn all_original_resource_node_outcomes(){
 let cases=cases();let data:Value=serde_json::from_str(include_str!("document_tests/all_resource_nodes.json")).unwrap();let mut failures=Vec::new();
 for c in cases.into_iter().filter(|c|data["rows"].as_array().unwrap().iter().any(|r|r["id"]==c["id"])){
  let package=ordinary::compile(inputs(&c),grammar::Profile::NativeV65).unwrap();let language=document::DocumentLanguage::prepare(&package,Default::default(),document::AnalysisLimits::workbench()).unwrap();
  for row in data["rows"].as_array().unwrap().iter().filter(|r|r["id"]==c["id"]){
   let source=Source{uri:"memory:node-analysis/all-resource".into(),text:row["text"].as_str().unwrap().into()};let result=language.analyze(&source,None,EvaluationLimits::workbench());let analysis=match result{Ok(a)=>a,Err(e)=>{failures.push(format!("{} {} unavailable: {e}",c["id"],row["text"]));continue}};
   let snapshot=&analysis.snapshot;let accepted=analysis.valid_model.is_some();if accepted!=row["resource"]["accepted"].as_bool().unwrap(){failures.push(format!("{} {} publication: {}",c["id"],row["text"],json!(analysis)));continue}
   compare_complete_objects(language.package(),&analysis,row,&mut failures);
   let leaves:Vec<_>=snapshot.document.nodes().iter().filter(|n|n.kind==intersect_model::core::text_document::NodeKind::Leaf).map(|n|json!({"text":snapshot.document.text_in(n.total_range).unwrap().unwrap(),"hidden":n.data.hidden,"utf16_start":n.range.start,"utf16_end":n.range.end,"syntax_error":n.data.syntax_error.map(|i|&snapshot.syntax_issues[i].message)})).collect();if json!(leaves)!=row["resource"]["all_root_leaves"]{failures.push(format!("{} {} leaves native={} expected={}",c["id"],row["text"],json!(leaves),row["resource"]["all_root_leaves"]));continue}
   let expected=row["nodes"]["nodes"].as_array().unwrap();let actual:Vec<_>=snapshot.document.nodes().iter().enumerate().map(|(i,n)|json!({"parent":n.parent,"kind":n.kind,"start":n.range.start,"end":n.range.end,"total_start":n.total_range.start,"total_end":n.total_range.end,"semantic":snapshot.semantic_object(intersect_model::core::text_document::NodeId(i)).unwrap(),"direct":n.data.direct_semantic_association})).collect();let expected:Vec<_>=expected.iter().map(|n|json!({"parent":n["parent"],"kind":n["kind"],"start":n["utf16_start"],"end":n["utf16_end"],"total_start":n["total_utf16_start"],"total_end":n["total_utf16_end"],"semantic":n["semantic_object"],"direct":n["direct_semantic_association"]})).collect();if actual!=expected{failures.push(format!("{} {} tree native={} expected={}",c["id"],row["text"],json!(actual),json!(expected)));}
  }
 }
 assert!(failures.is_empty(),"{} original mismatches:\n{}",failures.len(),failures.join("\n"));
}

fn objects(analysis:&document::DocumentAnalysis)->Vec<(&str,&str,&BTreeMap<String,Value>)>{
 if let Some(model)=&analysis.valid_model{model.model.elements.iter().map(|e|(e.id.as_str(),e.class.as_str(),&e.values)).collect()}else{analysis.recovered.as_ref().unwrap().objects.iter().map(|e|(e.id(),e.class(),e.values())).collect()}
}
fn classifier_identity(schema:&intersect_model::definitions::schema::Schema,key:&str)->String{
 let declaration=schema.declarations.get(key).expect("source-established class identity");format!("{}#//{}",declaration.namespace,declaration.name)
}
fn compare_complete_objects(package:&Package,analysis:&document::DocumentAnalysis,row:&Value,failures:&mut Vec<String>){
 let actual=objects(analysis);let expected=row["resource"]["model"].as_array().cloned().unwrap_or_default();
 if actual.len()!=expected.len(){failures.push(format!("{} {} object count {} vs{}",row["id"],row["text"],actual.len(),expected.len()));return}
 for (i,((_,class,values),expected)) in actual.iter().zip(&expected).enumerate(){
  if classifier_identity(&package.schema,class)!=expected["class"].as_str().unwrap(){failures.push(format!("{} {} class{i}: {class}",row["id"],row["text"]));continue}
  let expected_values=expected["values"].as_object().unwrap();if values.len()!=expected_values.len(){failures.push(format!("{} {} object{i} feature count",row["id"],row["text"]));continue}
  for(name,value)in *values{
   let feature=package.schema.effective_feature(class,name).unwrap();let wanted=&expected_values[name];
   if !feature.feature.reference{if value!=wanted{failures.push(format!("{} {} object{i}.{name}: {value} vs{wanted}",row["id"],row["text"]));}continue}
   let values:Vec<_>=if (feature.feature.upper!=1){value.as_array().unwrap().iter().collect()}else{vec![value]};let wanted:Vec<_>=if (feature.feature.upper!=1){wanted.as_array().unwrap().iter().collect()}else{vec![wanted]};
   if values.len()!=wanted.len(){failures.push(format!("{} {} object{i}.{name} reference count",row["id"],row["text"]));continue}
   for(value,wanted)in values.into_iter().zip(wanted){
    if value.is_null(){if !wanted.is_null(){failures.push(format!("{} {} object{i}.{name} unexpected null",row["id"],row["text"]));}continue}
    let id=value.as_str().unwrap();
    if let Some((target,(_,class,_)))=actual.iter().enumerate().find(|(_,o)|o.0==id){if wanted["object"]!=json!(target)||wanted["class"]!=json!(classifier_identity(&package.schema,class)){failures.push(format!("{} {} object{i}.{name} target {value} vs{wanted}",row["id"],row["text"]));}}
    else if let Some(spelling)=id.strip_prefix('?'){
     let references=row["references_after_resolution"].as_array().unwrap();let reference=references.iter().find(|r|r["owner"]==json!(i)&&r["feature"]==json!(name)).expect("actual unresolved source reference");let nodes=reference["nodes"].as_array().unwrap();let spelling_from_nodes:String=nodes.iter().flat_map(|n|n["leaves"].as_array().unwrap()).filter(|n|n["hidden"]==false).map(|n|n["text"].as_str().unwrap()).collect();let target=&reference["targets"][0];
     if spelling!=spelling_from_nodes||target["proxy"]!=true||wanted["external"]!=target["uri"]||wanted["class"]!=target["class"]{failures.push(format!("{} {} object{i}.{name} unresolved source identity {value} vs{wanted}",row["id"],row["text"]));}
    }else{failures.push(format!("{} {} object{i}.{name} unknown target {value}",row["id"],row["text"]));}
   }
  }
 }
}

#[test]
fn actual_named_and_construction_node_models(){
 let cases=cases();let mut failures=Vec::new();
 for data in [include_str!("document_tests/named_nodes.json"),include_str!("document_tests/construction_nodes.json")]{
  let data:Value=serde_json::from_str(data).unwrap();
  for c in cases.iter().filter(|c|data["rows"].as_array().unwrap().iter().any(|r|r["id"]==c["id"])){
   let package=ordinary::compile(inputs(c),grammar::Profile::NativeV65).unwrap();let language=document::DocumentLanguage::prepare(&package,Default::default(),document::AnalysisLimits::workbench()).unwrap();
   for row in data["rows"].as_array().unwrap().iter().filter(|r|r["id"]==c["id"]){
    let source=Source{uri:"memory:node-analysis/complete-consumers".into(),text:row["text"].as_str().unwrap().into()};let result=language.analyze(&source,row["entry"].as_str(),EvaluationLimits::workbench());let analysis=match result{Ok(a)=>a,Err(e)=>{failures.push(format!("{} {} entry{} unavailable: {e}",c["id"],row["text"],row["entry"]));continue}};
    let snapshot=&analysis.snapshot;if analysis.valid_model.is_some()!=row["resource"]["accepted"].as_bool().unwrap(){failures.push(format!("{} {} entry{} publication: {}",c["id"],row["text"],row["entry"],json!(analysis)));}
    compare_complete_objects(language.package(),&analysis,row,&mut failures);
    let leaves:Vec<_>=snapshot.document.nodes().iter().filter(|n|n.kind==intersect_model::core::text_document::NodeKind::Leaf).map(|n|json!({"text":snapshot.document.text_in(n.total_range).unwrap().unwrap(),"hidden":n.data.hidden,"utf16_start":n.range.start,"utf16_end":n.range.end,"syntax_error":n.data.syntax_error.map(|i|&snapshot.syntax_issues[i].message)})).collect();if json!(leaves)!=row["resource"]["all_root_leaves"]{failures.push(format!("{} {} entry{} leaves native={} expected={}",c["id"],row["text"],row["entry"],json!(leaves),row["resource"]["all_root_leaves"]));}
    let actual:Vec<_>=snapshot.document.nodes().iter().enumerate().map(|(i,n)|json!({"parent":n.parent,"kind":n.kind,"start":n.range.start,"end":n.range.end,"total_start":n.total_range.start,"total_end":n.total_range.end,"semantic":snapshot.semantic_object(intersect_model::core::text_document::NodeId(i)).unwrap(),"direct":n.data.direct_semantic_association})).collect();let expected:Vec<_>=row["nodes"]["nodes"].as_array().unwrap().iter().map(|n|json!({"parent":n["parent"],"kind":n["kind"],"start":n["utf16_start"],"end":n["utf16_end"],"total_start":n["total_utf16_start"],"total_end":n["total_utf16_end"],"semantic":n["semantic_object"],"direct":n["direct_semantic_association"]})).collect();if actual!=expected{failures.push(format!("{} {} entry{} tree native={} expected={}",c["id"],row["text"],row["entry"],json!(actual),json!(expected)));}
   }
  }
 }
 assert!(failures.is_empty(),"{} exact original named/construction mismatches:\n{}",failures.len(),failures.join("\n"));
}
