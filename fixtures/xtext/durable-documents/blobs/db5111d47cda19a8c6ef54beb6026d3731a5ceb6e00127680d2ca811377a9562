//! Private V65 controls. All authored source graphs are frozen originals or the
//! independently qualified namespace-only grouped companion; old inputs stay exact.
use super::*;
use intersect_model::definitions::{bundle::{DefinitionSource,SourceKind},schema::BundleCompilation};
fn cases() -> Vec<Value> { serde_json::from_str::<Value>(include_str!("document_tests/cases.json")).unwrap()["cases"].as_array().unwrap().clone() }
fn inputs(c:&Value)->BundleCompilation{serde_json::from_value(c["compilation"].clone()).unwrap()}
fn walk(expr:&Expr, source:&str, count:&mut usize){
 let range=expr.original_range.as_ref().expect("same-parser V65 origin"); assert!(range.start<=range.end&&range.end<=source.len(),"{range:?}"); assert!(source.is_char_boundary(range.start)&&source.is_char_boundary(range.end)); *count+=1;
 match &expr.kind {Kind::Sequence(v)|Kind::Alternative(v)=>for e in v{walk(e,source,count)},Kind::Assign{value,..}|Kind::BooleanAssign{value,..}=>walk(value,source,count),_=>{}}
}
#[test]
fn exact_authored_origins_and_legacy_absence(){
 for c in cases().into_iter().filter(|c|c["id"]!="grouped_objects_original") {
  let p=ordinary::compile(inputs(&c),grammar::Profile::NativeV65).unwrap_or_else(|e|panic!("{} {e:?}",c["id"]));let g=p.grammar.as_ref().unwrap();let b=&p.compilation.as_ref().unwrap().bundle;let mut count=0;
  for (name,rule) in &g.rules {let declaration=g.declaration_sources.get(name).unwrap();let source=b.sources.iter().find(|s|s.id==declaration.source).unwrap();walk(&rule.body,&source.text,&mut count);}
  assert!(count>0);assert_eq!(json!(crate::recompile(&p).unwrap()),json!(p));
  if c["id"]!="grouped_objects_namespace_companion" {let old=ordinary::compile(inputs(&c),grammar::Profile::NativeV64).unwrap();assert!(!json!(old).to_string().contains("original_range"));}
 }
}
#[test]
fn invalid_original_is_not_repaired_by_imported_hierarchy(){
 let cases=cases();let original=cases.iter().find(|c|c["id"]=="grouped_objects_original").unwrap();let e=ordinary::compile(inputs(original),grammar::Profile::NativeV65).unwrap_err();assert!(e.iter().any(|e|e.message.contains("upper case")),"{e:?}");
 let companion=cases.iter().find(|c|c["id"]=="grouped_objects_namespace_companion").unwrap();assert!(ordinary::compile(inputs(companion),grammar::Profile::NativeV64).unwrap_err().iter().any(|e|e.message.contains("Missing inferred hierarchy")));ordinary::compile(inputs(companion),grammar::Profile::NativeV65).unwrap();
}
#[test]
fn recovery_follows_only_actual_live_return_site(){
 let c=cases().remove(0);let mut input=inputs(&c);let old=input.xtext.clone().unwrap();let at=input.bundle.sources.iter().position(|s|s.id==old).unwrap();let mut src=DefinitionSource::new("memory:document-mechanics/ActualReturn.xtext",SourceKind::Xtext,"grammar document.mechanics.ActualReturn\nimport \"urn:intersect:xtext:mini-kerml:terminal-spellings:1\" as k\nimport \"http://www.eclipse.org/emf/2002/Ecore\" as ecore\nModel returns k::Model: name=Inner 'm';\nOther returns k::Model: name=Inner 'o';\nInner returns ecore::EString: 'a';\n");src.dependencies=input.bundle.sources[at].dependencies.clone();input.xtext=Some(src.id.clone());input.bundle.sources[at]=src;
 let p=ordinary::compile(input,grammar::Profile::NativeV65).unwrap();let program=p.grammar.as_ref().unwrap().parser_prediction.as_ref().unwrap();let mut work=Some(1000);
 let m=program.recovery_symbols_with_work("rule/Inner",&["rule/Model/s0/value"],&mut work).unwrap();assert_eq!(m,BTreeSet::from([grammar::PredictionSymbol::Keyword("m".into())]));let o=program.recovery_symbols_with_work("rule/Inner",&["rule/Other/s0/value"],&mut work).unwrap();assert_eq!(o,BTreeSet::from([grammar::PredictionSymbol::Keyword("o".into())]));assert_eq!(program.recovery_symbols_with_work("rule/Inner",&[],&mut work).unwrap(),BTreeSet::from([grammar::PredictionSymbol::End]));
 assert!(program.recovery_symbols_with_work("rule/Inner",&["rule/Model/s0/value"],&mut Some(0)).unwrap_err().contains("budget"));
}

#[test]
fn same_machine_durable_positive_nodes_and_complete_models(){
 let cases=cases();let data:Value=serde_json::from_str(include_str!("document_tests/positive_nodes.json")).unwrap();
 for c in cases.into_iter().filter(|c|data["rows"].as_array().unwrap().iter().any(|r|r["id"]==c["id"])) {
  let package=ordinary::compile(inputs(&c),grammar::Profile::NativeV65).unwrap();let language=document::DocumentLanguage::prepare(&package,Default::default(),document::AnalysisLimits::workbench()).unwrap();
  for row in data["rows"].as_array().unwrap().iter().filter(|r|r["id"]==c["id"]){
   let source=Source{uri:"memory:node-analysis/input".into(),text:row["text"].as_str().unwrap().into()};let analysis=language.analyze(&source,None,EvaluationLimits::native()).unwrap_or_else(|e|panic!("{} {} {e}",c["id"],row["text"]));
   assert!(analysis.recovered.is_none(),"{} {} {:?}",c["id"],row["text"],analysis.diagnostics);let model=analysis.valid_model.as_ref().unwrap();assert_eq!(json!(model),json!(evaluate(&package,std::slice::from_ref(&source))),"{} {}",c["id"],row["text"]);
   let snapshot=&analysis.snapshot;let leaves:Vec<_>=snapshot.document.nodes().iter().filter(|n|n.kind==intersect_model::core::text_document::NodeKind::Leaf).map(|n|json!({"text":snapshot.document.text_in(n.total_range).unwrap().unwrap(),"hidden":n.data.hidden,"utf16_start":n.range.start,"utf16_end":n.range.end,"syntax_error":null})).collect();assert_eq!(json!(leaves),row["resource"]["all_root_leaves"],"{} {}",c["id"],row["text"]);
   snapshot.document.check_resource(&model.model.resources[&source.uri]).unwrap();let mut stale=model.model.resources[&source.uri].clone();stale.content_revision+=1;assert!(snapshot.document.check_resource(&stale).is_err());
   let expected=row["nodes"]["nodes"].as_array().unwrap();assert_eq!(snapshot.document.nodes().len(),expected.len(),"{} {} native {} vs upstream {}",c["id"],row["text"],json!(snapshot),row["nodes"]);
   for (i,(node,expected)) in snapshot.document.nodes().iter().zip(expected).enumerate(){assert_eq!(json!(node.parent),expected["parent"],"{} {} node{i}",c["id"],row["text"]);assert_eq!(node.range.start,expected["utf16_start"].as_u64().unwrap()as usize);assert_eq!(node.range.end,expected["utf16_end"].as_u64().unwrap()as usize);assert_eq!(node.total_range.start,expected["total_utf16_start"].as_u64().unwrap()as usize);assert_eq!(node.total_range.end,expected["total_utf16_end"].as_u64().unwrap()as usize);assert_eq!(json!(snapshot.semantic_object(intersect_model::core::text_document::NodeId(i)).unwrap()),expected["semantic_object"]);}
  }
 }
}

