public class ReferenceScopeRuntime extends HiddenScopeRuntime {

 static Object referenceNodes(EObject root,Map<String,Object> authoredSources){
  List<Object> result=new ArrayList<>();if(root==null)return result;
  List<EObject> objects=new ArrayList<>();objects.add(root);root.eAllContents().forEachRemaining(objects::add);
  IdentityHashMap<EObject,Integer> ids=new IdentityHashMap<>();for(int index=0;index<objects.size();index++)ids.put(objects.get(index),index);
  for(EObject object:objects)for(EReference feature:object.eClass().getEAllReferences())if(!feature.isContainment()&&!feature.isContainer()){
   List<Object> nodes=new ArrayList<>();for(var node:NodeModelUtils.findNodesForFeature(object,feature)){
    var element=node.getGrammarElement();var grammar=element==null?null:GrammarUtil.getGrammar(element);
    nodes.add(fields("text",node.getText(),"utf16_start",node.getOffset(),"utf16_end",node.getEndOffset(),"total_utf16_start",node.getTotalOffset(),"total_utf16_end",node.getTotalEndOffset(),"grammar_element_uri",element==null?null:org.eclipse.emf.ecore.util.EcoreUtil.getURI(element).toString(),"authored_source_for_owner",grammar==null?null:authoredSources.get(grammar.getName()),"leaves",leaves(node)));
   }
   Object value=object.eGet(feature,false);List<Object> targets=new ArrayList<>();List<?> values=value instanceof List<?>?(List<?>)value:Collections.singletonList(value);
   for(Object item:values)if(item instanceof EObject){var target=(EObject)item;targets.add(fields("proxy",target.eIsProxy(),"object",ids.get(target),"uri",org.eclipse.emf.ecore.util.EcoreUtil.getURI(target).toString(),"class",target.eClass().getEPackage().getNsURI()+"#//"+target.eClass().getName()));}
   result.add(fields("owner",ids.get(object),"owner_class",object.eClass().getEPackage().getNsURI()+"#//"+object.eClass().getName(),"feature",feature.getName(),"nodes",nodes,"targets",targets));
  }return result;
 }
 public static void main(String[] args)throws Exception{
  if(args.length!=5)throw new IllegalArgumentException("Expected provider,grammar,text,explicit-entry-or-empty,pinned-source-bindings");var authoredSources=sourceBindings(args[4]);String requestedEntry=args[3];
  for(String name:args[0].split(",")){var p=(EPackage)Class.forName(name).getField("eINSTANCE").get(null);EPackage.Registry.INSTANCE.put(p.getNsURI(),p);}
  var setup=(ISetup)Class.forName(args[1]+"StandaloneSetup").getConstructor().newInstance();var injector=setup.createInjectorAndDoEMFRegistration();String text=new String(Base64.getDecoder().decode(args[2]),StandardCharsets.UTF_8);
  Map<String,Object> result=fields("text",text,"named_entry",requestedEntry.isEmpty()?null:requestedEntry,"lexer",null,"resource",null,"parser",null);
  try{var lexer=injector.getInstance(org.eclipse.xtext.parser.antlr.Lexer.class);lexer.setCharStream(new ANTLRStringStream(text));Map<Integer,String> names=new TreeMap<>();for(var f:lexer.getClass().getFields())if(f.getType()==int.class&&java.lang.reflect.Modifier.isStatic(f.getModifiers())&&(f.getName().startsWith("RULE_")||f.getName().startsWith("T__")))names.put(f.getInt(null),f.getName());List<Object> tokens=new ArrayList<>();boolean complete=false;for(int n=0;n<text.length()+4;n++){var t=(CommonToken)lexer.nextToken();tokens.add(fields("type",t.getType(),"name",t.getType()==Token.EOF?"EOF":names.get(t.getType()),"text",t.getText(),"utf16_start",t.getStartIndex(),"utf16_stop",t.getStopIndex(),"channel",t.getChannel()));if(t.getType()==Token.EOF){complete=true;break;}}result.put("lexer",fields("tokens",tokens,"through_eof",complete,"antlr_syntax_error_count",lexer.getNumberOfSyntaxErrors(),"failure",null));}catch(Throwable t){result.put("lexer",fields("failure",failure(t)));}
  org.eclipse.emf.ecore.resource.Resource resource=null;
  try{var resources=injector.getInstance(XtextResourceSet.class);resource=resources.createResource(URI.createURI("memory:/model.lexicaltest"));resource.load(new ByteArrayInputStream(text.getBytes(StandardCharsets.UTF_8)),null);var loadedRoot=resource.getContents().isEmpty()?null:resource.getContents().get(0);result.put("references_before_resolution",referenceNodes(loadedRoot,authoredSources));org.eclipse.emf.ecore.util.EcoreUtil.resolveAll(resource);result.put("references_after_resolution",referenceNodes(loadedRoot,authoredSources));List<Object> errors=new ArrayList<>();for(var d:resource.getErrors())errors.add(fields("message",d.getMessage(),"line",d.getLine(),"column",d.getColumn()));List<Object> warnings=new ArrayList<>();for(var d:resource.getWarnings())warnings.add(fields("message",d.getMessage(),"line",d.getLine(),"column",d.getColumn()));var root=resource.getContents().isEmpty()?null:resource.getContents().get(0);List<Object> leaves=new ArrayList<>();if(root!=null){var node=NodeModelUtils.getNode(root);if(node!=null)for(var leaf:node.getLeafNodes())leaves.add(fields("text",leaf.getText(),"hidden",leaf.isHidden(),"utf16_start",leaf.getOffset(),"utf16_end",leaf.getEndOffset(),"syntax_error",leaf.getSyntaxErrorMessage()==null?null:leaf.getSyntaxErrorMessage().getMessage()));}result.put("resource",fields("accepted",root!=null&&errors.isEmpty(),"errors",errors,"warnings",warnings,"resource_contents",resource.getContents().size(),"model",RuntimeOracle.model(root),"leaves",leaves,"all_root_leaves",leaves(((org.eclipse.xtext.resource.XtextResource)resource).getParseResult().getRootNode()),"model_nodes",modelNodes(root),"failure",null));}catch(Throwable t){result.put("resource",fields("accepted",false,"failure",failure(t),"resource_contents",resource==null?null:resource.getContents().size(),"model",resource==null||resource.getContents().isEmpty()?null:RuntimeOracle.model(resource.getContents().get(0))));}
  try{var grammar=injector.getInstance(IGrammarAccess.class).getGrammar();var parser=injector.getInstance(IParser.class);org.eclipse.xtext.parser.IParseResult parsed;if(requestedEntry.isEmpty()){parsed=parser.parse(new StringReader(text));result.put("selected_parser_entry",null);}else{var selected=GrammarUtil.findRuleForName(grammar,requestedEntry);if(!(selected instanceof ParserRule)||!requestedEntry.equals(selected.getName()))throw new IllegalArgumentException("Requested named entry is not an exact ParserRule");var selectedParser=(ParserRule)selected;result.put("selected_parser_entry",selectedRule(selectedParser,requestedEntry,authoredSources));parsed=parser.parse(selectedParser,new StringReader(text));}List<Object> errors=new ArrayList<>();for(var n:parsed.getSyntaxErrors())errors.add(fields("message",n.getSyntaxErrorMessage().getMessage(),"utf16_start",n.getOffset(),"utf16_end",n.getEndOffset()));var root=parsed.getRootASTElement();result.put("parser",fields("accepted",root!=null&&errors.isEmpty(),"errors",errors,"model",RuntimeOracle.model(root),"all_root_leaves",leaves(parsed.getRootNode()),"model_nodes",modelNodes(root),"failure",null));}catch(Throwable t){result.put("parser",fields("accepted",false,"failure",failure(t)));}
  System.out.println(TerminalNegationOracle.json(result));
 }
