grammar mini.QualifiedNames with org.eclipse.xtext.common.Terminals
import "urn:intersect:xtext:mini-kerml:qualified-names:1" as k
import "http://www.eclipse.org/emf/2002/Ecore" as ecore
Model returns k::Model: 'package' name=ID '{' members+=Member* '}';
Member returns k::Element: Type | Feature;
Type returns k::Type: 'type' name=QualifiedName ';';
Feature returns k::Feature: 'feature' name=ID ':' target=[k::Type|QualifiedName] ';';
QualifiedName returns ecore::EString: ID ('::' ID)*;
