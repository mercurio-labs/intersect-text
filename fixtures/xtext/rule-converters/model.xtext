grammar evidence.RuleConverters hidden(WS)
import "urn:intersect:xtext:rule-converters:1" as p
import "http://www.eclipse.org/emf/2002/Ecore" as Ecore
Model returns p::Model: 'feature' name=ID (isUnique=Nonunique)? ';';
Nonunique returns Ecore::EBoolean :
	// Note: A value converter converts the value of this keyword to "false".
	'nonunique'
;
terminal ID: ('a'..'z'|'A'..'Z'|'_') ('a'..'z'|'A'..'Z'|'_'|'0'..'9')*;
terminal WS: (' '|'\t'|'\r'|'\n')+;
