grammar audit.scopes.QualifiedRuleHiddenOverrideChild with audit.scopes.QualifiedRuleHiddenOverrideBase
import "urn:intersect:xtext:mini-kerml:terminal-spellings:1" as k
import "http://www.eclipse.org/emf/2002/Ecore" as ecore
Entry returns k::Model hidden(super::WS): Model;
