grammar audit.scopes.CallerSuffix hidden(WS,ML_COMMENT,SL_COMMENT)
import "urn:intersect:xtext:mini-kerml:terminal-spellings:1" as k
import "http://www.eclipse.org/emf/2002/Ecore" as ecore
Model returns k::Model: name=Loose '!' | name=Tight '?' | 'direct' TightEntry 'done';
TightEntry returns k::Model hidden(): name=Tight '?';
Loose returns ecore::EString hidden(WS,ML_COMMENT): 'a' 'b';
Tight returns ecore::EString hidden(): 'a' WS 'b';
terminal ID returns ecore::EString: ('a'..'z'|'\u00e9')+;
terminal WS returns ecore::EString: (' '|'\t'|'\r'|'\n')+;
terminal ML_COMMENT returns ecore::EString: '/*' ->'*/';
terminal SL_COMMENT returns ecore::EString: '//' !('\n'|'\r')* ('\r'? '\n')?;
