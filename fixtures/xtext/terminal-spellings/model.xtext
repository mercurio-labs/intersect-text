grammar mini.TerminalSpellings with org.eclipse.xtext.common.Terminals
import "urn:intersect:xtext:mini-kerml:terminal-spellings:1" as k
import "http://www.eclipse.org/emf/2002/Ecore" as ecore
Model returns k::Model: 'package' name=ID '{' members+=Member* '}';
Member returns k::Element: Type | Feature;
Type returns k::Type: 'type' name=TAG ';';
Feature returns k::Feature: 'feature' name=ID ':' target=[k::Type|Name] ';';
Name returns ecore::EString: TAG;
terminal TAG returns ecore::EString:
    '@' ('a'..'z' | 'A'..'Z' | '_') ('a'..'z' | 'A'..'Z' | '_' | '0'..'9')*;
