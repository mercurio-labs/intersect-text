grammar example.Base hidden(WS)
import "urn:intersect:xtext:mini-kerml:inherited-grammar:1" as k
import "http://www.eclipse.org/emf/2002/Ecore" as Ecore
Type returns k::Type: 'type' name=Name ';';
Name returns Ecore::EString: ID;
terminal ID: ('a'..'z'|'A'..'Z'|'_') ('a'..'z'|'A'..'Z'|'_'|'0'..'9')*;
terminal WS: (' '|'\t'|'\r'|'\n')+;
