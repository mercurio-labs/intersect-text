grammar audit.ReturnMatrixGeneratedAndAliasedEcoreImplicit hidden()
import "urn:intersect:xtext:mini-kerml:terminal-spellings:1" as k
generate own "urn:intersect:xtext:terminal-return-matrix:generated-ecore:1"
import "http://www.eclipse.org/emf/2002/Ecore" as ecore
Model returns k::Model: name=VALUE;
terminal VALUE: 'a';
