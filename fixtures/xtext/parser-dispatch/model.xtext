grammar mini.ParserDispatch with org.eclipse.xtext.common.Terminals
import "urn:intersect:xtext:mini-kerml:dispatch:1" as k
Model returns k::Model: 'package' name=ID '{' members+=Member* '}';
Member returns k::Element: Type | Feature;
Type returns k::Type: isAbstract?='abstract'? 'type' name=ID ';';
Feature returns k::Feature: 'feature' name=ID ';';
