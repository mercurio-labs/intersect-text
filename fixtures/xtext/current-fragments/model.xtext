grammar currentFragments hidden(WS)
import "urn:intersect:xtext:current-actions:1" as k
import "http://www.eclipse.org/emf/2002/Ecore" as ecore
Model returns k::Model: name=ID '=' value=Expression ';';
Expression returns k::Expression:
    Literal ({k::OperatorExpression.operand+=current} Suffix)*
  | {k::OperatorExpression} 'prefix' Prefix;
fragment Suffix returns k::OperatorExpression: operator='+' Operands;
fragment Prefix returns k::OperatorExpression: operator='all' '(' Operands ')';
fragment Operands returns k::OperatorExpression: operand+=Literal (',' operand+=Literal)*;
Literal returns k::Literal: value=INT;
terminal ID: ('a'..'z'|'A'..'Z')+;
terminal INT returns ecore::EInt: ('0'..'9')+;
terminal WS: (' '|'\n')+;
