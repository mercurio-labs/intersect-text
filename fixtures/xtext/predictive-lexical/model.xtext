// Independently authored parser/metamodel. All nine terminal declarations are
// exact pinned KerMLExpressions source slices with provenance retained separately.
grammar mini.PredictiveLexical hidden(WS, ML_NOTE, SL_NOTE)
import "urn:intersect:xtext:mini-kerml:predictive-lexical:1" as k
import "http://www.eclipse.org/emf/2002/Ecore" as Ecore
Model returns k::Model: 'package' name=ID (documentation=REGULAR_COMMENT)? '{' members+=Member* '}';
Member returns k::Element: Type | Feature;
Type returns k::Type: 'type' name=Name ('count' count=DECIMAL_VALUE)? ('magnitude' magnitude=Number)? ';';
Feature returns k::Feature: 'feature' name=ID ':' target=[k::Type|Name] ';';
Name returns Ecore::EString: ID | UNRESTRICTED_NAME;
Number returns Ecore::EString: DECIMAL_VALUE | EXP_VALUE;

terminal DECIMAL_VALUE returns Ecore::EInt:
	'0'..'9' ('0'..'9')*;

terminal EXP_VALUE:
	DECIMAL_VALUE ('e' | 'E') ('+' | '-')? DECIMAL_VALUE;

terminal ID:
	('a'..'z' | 'A'..'Z' | '_') ('a'..'z' | 'A'..'Z' | '_' | '0'..'9')*;

terminal UNRESTRICTED_NAME returns Ecore::EString:
	'\'' ('\\' ('b' | 't' | 'n' | 'f' | 'r' | '"' | "'" | '\\') | !('\\' | '\''))* '\'';

terminal STRING_VALUE returns Ecore::EString:
	'"' ('\\' ('b' | 't' | 'n' | 'f' | 'r' | '"' | "'" | '\\') | !('\\' | '"'))* '"';

terminal REGULAR_COMMENT:
	'/*' ->'*/';

terminal ML_NOTE:
	'//*'->'*/';

terminal SL_NOTE:
	'//' (!('\n' | '\r') !('\n' | '\r')*)? ('\r'? '\n')?;

terminal WS:
	(' ' | '\t' | '\r' | '\n')+;
