grammar example.Unqualified hidden(WS)
import "urn:unqualified:main" as p
import "urn:unqualified:other" as q
import "http://www.eclipse.org/emf/2002/Ecore" as ecore
Model returns Model: {Model} 'model' name=Name shade=Choice ('ref' target=[Model|Name])?;
Name returns EString: ID;
enum Choice returns Shade: Red='red' | Blue='blue';
terminal ID returns EString: ('a'..'z')+;
terminal WS: ' '+;
