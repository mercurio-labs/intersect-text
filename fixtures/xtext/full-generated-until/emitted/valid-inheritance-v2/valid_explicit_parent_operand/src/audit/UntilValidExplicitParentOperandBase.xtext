grammar audit.UntilValidExplicitParentOperandBase hidden()
import "urn:intersect:xtext:mini-kerml:terminal-spellings:1" as k
import "http://www.eclipse.org/emf/2002/Ecore" as ecore
Model returns k::Model: name=VALUE;
terminal VALUE returns ecore::EString: '@' ->END;
terminal fragment END: 'abc'|'b';
