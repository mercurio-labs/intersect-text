grammar groupedObjects hidden(WS)
import "urn:intersect:xtext:current-actions:1" as k
import "http://www.eclipse.org/emf/2002/Ecore" as ecore
Model returns k::Model: name=ID '=' value=(Literal | Operator) ';';
Literal returns k::Literal: value=INT;
Operator returns k::OperatorExpression: operator='sum' '(' operand+=(Literal | Operator) (',' operand+=(Literal | Operator))* ')';
terminal ID: ('a'..'z'|'A'..'Z')+;
terminal INT returns ecore::EInt: ('0'..'9')+;
terminal WS: ' '+;
