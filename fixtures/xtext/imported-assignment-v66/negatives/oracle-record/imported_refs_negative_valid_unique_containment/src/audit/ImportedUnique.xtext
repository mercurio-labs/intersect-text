grammar audit.ImportedUnique hidden(WS)
import "urn:intersect:xtext:imported-unique:1" as u
import "http://www.eclipse.org/emf/2002/Ecore" as ecore
Model returns u::Model:
  'nodes' nodes+=Node (',' nodes+=Node)* ';' 'refs' refs+=[u::Node|ID] (',' refs+=[u::Node|ID])* ';';
Node returns u::Node: name=ID;
terminal ID returns ecore::EString: ('a'..'z')+;
terminal WS returns ecore::EString: (' '|'\t'|'\r'|'\n')+;
