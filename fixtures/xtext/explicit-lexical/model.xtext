// Independently authored parser example; terminal declarations below are exact
// slices of the pinned KerMLExpressions source, recorded in provenance.json.
grammar mini.ExplicitLexical hidden(WS)
import "urn:intersect:xtext:mini-kerml:explicit-lexical:1" as k
import "http://www.eclipse.org/emf/2002/Ecore" as Ecore
Model returns k::Model: 'package' name=ID (documentation=REGULAR_COMMENT)? '{' members+=Member* '}';
Member returns k::Element: Type | Feature;
Type returns k::Type: 'type' name=Name ('description' description=STRING_VALUE)? ';';
Feature returns k::Feature: 'feature' name=ID ':' target=[k::Type|Name] ';';
Name returns Ecore::EString: ID | UNRESTRICTED_NAME;

terminal ID:
	('a'..'z' | 'A'..'Z' | '_') ('a'..'z' | 'A'..'Z' | '_' | '0'..'9')*;

terminal UNRESTRICTED_NAME returns Ecore::EString:
	'\'' ('\\' ('b' | 't' | 'n' | 'f' | 'r' | '"' | "'" | '\\') | !('\\' | '\''))* '\'';

terminal STRING_VALUE returns Ecore::EString:
	'"' ('\\' ('b' | 't' | 'n' | 'f' | 'r' | '"' | "'" | '\\') | !('\\' | '"'))* '"';

terminal REGULAR_COMMENT:
	'/*' ->'*/';

terminal WS:
	(' ' | '\t' | '\r' | '\n')+;
