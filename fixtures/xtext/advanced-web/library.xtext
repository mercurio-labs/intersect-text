// Authored Library syntax demonstration; uses the unchanged Library metamodel and semantics.
grammar example.LibraryAdvanced hidden(WS)
import "urn:intersect:example:library:1" as lib
import "http://www.eclipse.org/emf/2002/Ecore" as Ecore
Library returns lib::Library: 'library' name=ID '{' (copies+=BookCopy | members+=Member | loans+=Loan)* '}';
BookCopy returns lib::BookCopy: DetailedCopy | ShortCopy | '(' BookCopy ')';
DetailedCopy returns lib::BookCopy: 'copy' Identity ':' title=ID ('edition' edition=INT)? ';';
ShortCopy returns lib::BookCopy: {lib::BookCopy} 'copy' Identity title='untitled' ';';
fragment Identity returns lib::Named: name=ID;
Member returns lib::Member: 'member' Identity ';';
Loan returns lib::Loan: 'loan' Identity 'copy' copy=[lib::BookCopy|ID] 'to' member=[lib::Member|ID] ';';
terminal ID: ('a'..'z'|'A'..'Z')+;
terminal INT returns Ecore::EInt: ('0'..'9')+;
terminal WS: (' '|'\t'|'\r'|'\n')+;
