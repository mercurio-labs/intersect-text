<e:EPackage xmlns:e="http://www.eclipse.org/emf/2002/Ecore" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="paint" nsURI="urn:paint">
  <eClassifiers xsi:type="e:EDataType" name="RGB" instanceClassName="example.RGB"/>
  <eClassifiers xsi:type="e:EClass" name="Paint">
    <eStructuralFeatures xsi:type="e:EAttribute" name="color" eType="#//RGB" unsettable="true" defaultValueLiteral="#123abc"/>
    <eStructuralFeatures xsi:type="e:EAttribute" name="optional" eType="#//RGB" unsettable="true"/>
    <eStructuralFeatures xsi:type="e:EAttribute" name="colors" eType="#//RGB" upperBound="-1" unsettable="true"/>
  </eClassifiers>
</e:EPackage>
