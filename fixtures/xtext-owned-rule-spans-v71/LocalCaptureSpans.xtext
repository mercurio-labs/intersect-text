grammar intersect.oracle.LocalCaptureSpans hidden(WS, COMMENT)
import "urn:intersect:oracle:semantic-object-spans-v71" as m
import "http://www.eclipse.org/emf/2002/Ecore" as ecore
Root returns m::Node: LateCapture | ConsecutiveCapture | ConsumingCapture;
LateCapture returns m::Node:
  'one' {m::Empty} {m::Root.previous=current} name=Name ':=' value=Name ';';
ConsecutiveCapture returns m::Node:
  'two' {m::Empty} {m::Root.previous=current} {m::Root.previous=current} name=Name ':=' value=Name ';';
ConsumingCapture returns m::Node:
  'three' {m::Leaf} name=Name {m::Root.previous=current} value=Name ';';
Name returns ecore::EString: ID;
terminal ID returns ecore::EString: ('a'..'z')+;
terminal WS returns ecore::EString: (' '|'\t'|'\r'|'\n')+;
terminal COMMENT returns ecore::EString: '/*' -> '*/';
