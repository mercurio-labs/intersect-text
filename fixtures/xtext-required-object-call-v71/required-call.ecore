<?xml version="1.0" encoding="UTF-8"?>
<e:EPackage xmlns:e="http://www.eclipse.org/emf/2002/Ecore" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="requiredCallV71" nsURI="urn:intersect:oracle:required-object-call-v71" nsPrefix="requiredCallV71">
  <eClassifiers xsi:type="e:EClass" name="Root">
    <eStructuralFeatures xsi:type="e:EReference" name="target" eType="#//Target" lowerBound="1" containment="true"/>
    <eStructuralFeatures xsi:type="e:EAttribute" name="name" eType="e:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" lowerBound="1"/>
    <eStructuralFeatures xsi:type="e:EAttribute" name="value" eType="e:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" lowerBound="1"/>
  </eClassifiers>
  <eClassifiers xsi:type="e:EClass" name="Target">
    <eStructuralFeatures xsi:type="e:EReference" name="binding" eType="#//Binding" containment="true"/>
    <eStructuralFeatures xsi:type="e:EReference" name="empty" eType="#//Empty" lowerBound="1" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="e:EClass" name="Binding">
    <eStructuralFeatures xsi:type="e:EAttribute" name="name" eType="e:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="e:EReference" name="inner" eType="#//Binding" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="e:EClass" name="Empty"/>
</e:EPackage>
