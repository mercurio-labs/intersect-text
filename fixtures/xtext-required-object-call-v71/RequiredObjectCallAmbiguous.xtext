grammar intersect.oracle.RequiredObjectCallAmbiguous hidden(WS)
import "urn:intersect:oracle:required-object-call-v71" as m
import "http://www.eclipse.org/emf/2002/Ecore" as ecore
Root returns m::Root:
  'one' target=Target name=Name? ':=' value=Name ';'
| 'two' target=Target name=Name? ':=' value=Name '!';
Target returns m::Target: (=> 'z' binding=Binding '.')? (binding=Binding)? empty=Empty;
Binding returns m::Binding: (=> '(' inner=Binding ')') | name=Name;
Empty returns m::Empty: {m::Empty};
Name returns ecore::EString: ID;
terminal ID returns ecore::EString: ('a'..'z')+;
terminal WS returns ecore::EString: (' '|'\t'|'\r'|'\n')+;
