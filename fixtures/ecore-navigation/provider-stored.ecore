<?xml version="1.0" encoding="UTF-8"?>
<e:EPackage xmlns:e="http://www.eclipse.org/emf/2002/Ecore" xmlns:x="http://www.w3.org/2001/XMLSchema-instance" name="provider_navigation" nsURI="urn:intersect:provider-navigation">
  <eClassifiers x:type="e:EDataType" name="RGB" instanceClassName="example.RGB"/>
  <eClassifiers x:type="e:EClass" name="Node">
    <eStructuralFeatures x:type="e:EAttribute" name="color" lowerBound="1" eType="#//RGB"/>
    <eStructuralFeatures x:type="e:EAttribute" name="colors" upperBound="-1" ordered="true" unique="true" eType="#//RGB"/>
    <eStructuralFeatures x:type="e:EReference" name="peer" eType="#//Node"/>
  </eClassifiers>
</e:EPackage>
