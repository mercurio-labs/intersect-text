<e:EPackage xmlns:e="http://www.eclipse.org/emf/2002/Ecore" xmlns:x="http://www.w3.org/2001/XMLSchema-instance" name="navigation" nsURI="urn:generic-navigation">
  <eClassifiers x:type="e:EClass" name="Base"/>
  <eClassifiers x:type="e:EClass" name="Leaf" eSuperTypes="#//Base"/>
  <eClassifiers x:type="e:EClass" name="Box">
    <eTypeParameters name="T"><eBounds eClassifier="#//Base"/></eTypeParameters>
    <eStructuralFeatures x:type="e:EReference" name="value"><eGenericType eTypeParameter="#//Box/T"/></eStructuralFeatures>
    <eStructuralFeatures x:type="e:EReference" name="items" upperBound="-1" unique="false"><eGenericType eTypeParameter="#//Box/T"/></eStructuralFeatures>
  </eClassifiers>
  <eClassifiers x:type="e:EClass" name="Child">
    <eTypeParameters name="U"><eBounds eClassifier="#//Base"/></eTypeParameters>
    <eGenericSuperTypes eClassifier="#//Box"><eTypeArguments eTypeParameter="#//Child/U"/></eGenericSuperTypes>
  </eClassifiers>
</e:EPackage>
