<ecore:EPackage xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="mini" nsPrefix="k" nsURI="urn:intersect:xtext:mini-kerml:boolean:1">
  <eClassifiers xsi:type="ecore:EClass" name="Model">
